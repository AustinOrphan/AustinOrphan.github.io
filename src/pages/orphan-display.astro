---
// Orphan Display: the specimen, with its two axes live.
//
// The font is a real variable font built from twelve masters, so the sliders move the outlines
// rather than picking from pre-rendered images. The named instances are the same ones baked
// into the fvar table, so a preset here and a preset in a design tool are the same thing.
import BaseLayout from '../layouts/BaseLayout.astro';

const PRESETS = [
  { name: 'Thin',         wght: 280, push: 100 },
  { name: 'Light',        wght: 340, push: 100 },
  { name: 'Regular',      wght: 400, push: 100 },
  { name: 'Medium',       wght: 480, push: 100 },
  { name: 'Bold',         wght: 580, push: 100 },
  { name: 'Black',        wght: 800, push: 100 },
  { name: 'Light Flat',   wght: 340, push: 30  },
  { name: 'Regular Soft', wght: 400, push: 65  },
  { name: 'Regular Flat', wght: 400, push: 30  },
  { name: 'Bold Flat',    wght: 580, push: 30  },
  { name: 'Black Flat',   wght: 800, push: 30  },
];
const SIZES = [88, 46, 27, 17];
---
<BaseLayout title="Orphan Display" description="A typeface derived from the AO mark, with its two axes live."
            bodyClass="od-page" robots="noindex, nofollow">
  <main class="od">
    <header class="od-head">
      <h1>Orphan Display</h1>
      <p>
        Drawn from the AO mark. The A and the O are the mark itself; every other glyph is built
        to rules measured off those two. Two axes, both derived rather than styled: 
        <b>weight</b> scales the stroke, and <b>contrast</b> scales the O counter&rsquo;s
        displacement &mdash; which is where all of the face&rsquo;s stress comes from.
      </p>
    </header>

    <section class="od-controls" aria-label="Axes">
      <label>
        <span>weight <output data-out="wght">400</output></span>
        <input type="range" data-axis="wght" min="280" max="800" step="1" value="400">
      </label>
      <label>
        <span>contrast <output data-out="push">100</output></span>
        <input type="range" data-axis="push" min="30" max="100" step="1" value="100">
      </label>
      <label class="od-size">
        <span>size <output data-out="size">112</output>px</span>
        <input type="range" data-size min="18" max="260" step="1" value="112">
      </label>
      <div class="od-presets">
        {PRESETS.map((p) => (
          <button type="button" data-preset data-wght={p.wght} data-push={p.push}>{p.name}</button>
        ))}
      </div>
    </section>

    <section class="od-stage" aria-label="Specimen">
      <div class="od-sample" contenteditable="true" spellcheck="false"
           aria-label="Editable specimen">HAMBURGEFONS</div>
      <p class="od-hint">the line above is editable</p>
    </section>

    <section class="od-sheet" aria-label="Character set">
      <h2>the set</h2>
      <div class="od-row od-big">ABCDEFGHIJKLMNOPQRSTUVWXYZ</div>
      <div class="od-row od-big">0123456789</div>
      <div class="od-row od-mid">&amp;@#%*()[]&#123;&#125;.,:;!?&quot;&#39;-+=/_</div>
    </section>

    <section class="od-sheet" aria-label="At size">
      <h2>at size</h2>
      {SIZES.map((s) => (
        <div class="od-line" style={`font-size:${s}px`}>
          <span class="od-line-n">{s}</span>
          <span>Orphan Display &mdash; the quick brown fox jumps over 13 lazy dogs</span>
        </div>
      ))}
    </section>

    <section class="od-sheet" aria-label="Download">
      <h2>download</h2>
      <p class="od-note">
        One variable font, two axes, eight named instances. 8&nbsp;KB compressed.
      </p>
      <p class="od-dl">
        <a href="/fonts/OrphanDisplay-VF.woff2" download>woff2</a>
        <a href="/fonts/OrphanDisplay-VF.ttf" download>ttf</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: 'Orphan Display';
    src: url('/fonts/OrphanDisplay-VF.woff2') format('woff2-variations'),
         url('/fonts/OrphanDisplay-VF.ttf') format('truetype-variations');
    font-weight: 340 580;
    font-display: swap;
  }
  .od-page { background: var(--color-background); color: var(--color-primary); margin: 0; }
  .od {
    max-width: 72rem; margin: 0 auto; padding: 3rem 1.5rem 6rem;
    font-family: 'Comfortaa', sans-serif;
  }
  /* The site gives h1 the hero treatment -- a red stroke and a blue offset copy -- and gives
     p the accent colour. Neither belongs on a specimen, where the only thing on show is the
     face itself. */
  .od-head h1 {
    font-family: 'Orphan Display', 'Anta', sans-serif;
    font-size: clamp(2.5rem, 9vw, 6rem); margin: 0 0 .5rem; font-weight: 400;
    letter-spacing: .01em;
    color: var(--color-primary);
    -webkit-text-stroke: 0; text-shadow: none;
  }
  .od-head p, .od-hint, .od-note {
    color: var(--color-primary);
    max-width: 46rem; line-height: 1.6; opacity: .8; font-size: .95rem;
  }
  .od-head b { font-weight: 700; opacity: 1; }

  .od-controls {
    position: sticky; top: 0; z-index: 5;
    display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; align-items: center;
    margin: 2rem 0; padding: 1rem 1.25rem; border-radius: .75rem;
    background: color-mix(in srgb, var(--color-background) 88%, var(--color-primary));
    backdrop-filter: blur(6px);
  }
  .od-controls label { display: flex; flex-direction: column; gap: .35rem; font-size: .78rem; }
  .od-controls label span { opacity: .75; letter-spacing: .04em; text-transform: uppercase; }
  .od-controls output { font-variant-numeric: tabular-nums; font-weight: 700; opacity: 1; }
  .od-controls input[type="range"] { width: 13rem; accent-color: var(--color-accent); }
  .od-presets { display: flex; flex-wrap: wrap; gap: .4rem; margin-left: auto; }
  .od-presets button {
    font: inherit; font-size: .74rem; padding: .35rem .7rem; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    background: transparent; color: var(--color-primary); cursor: pointer;
  }
  .od-presets button:hover { border-color: var(--color-accent); }
  .od-presets button[aria-pressed="true"] { background: var(--color-accent); border-color: var(--color-accent); }

  .od-stage { margin: 2.5rem 0 1rem; }
  .od-sample {
    font-family: 'Orphan Display', serif; line-height: 1.1; word-break: break-word;
    outline: none; padding: .2em 0;
  }
  .od-sample:focus-visible { box-shadow: 0 0 0 2px var(--color-accent); border-radius: .25rem; }
  .od-hint { font-size: .72rem; opacity: .45; margin: 0 0 2rem; }
  .od-sample { font-size: 112px; }

  .od-sheet { margin: 3rem 0; }
  .od-sheet h2 {
    font-size: .74rem; text-transform: uppercase; letter-spacing: .12em; opacity: .55;
    margin: 0 0 .9rem; font-weight: 400;
  }
  .od-row { font-family: 'Orphan Display', serif; line-height: 1.35; word-break: break-word; }
  .od-big { font-size: clamp(1.7rem, 4.6vw, 3rem); }
  .od-mid { font-size: clamp(1.3rem, 3.2vw, 2.1rem); }
  .od-line {
    font-family: 'Orphan Display', serif; line-height: 1.3; margin: .5rem 0;
    display: flex; gap: 1rem; align-items: baseline;
  }
  .od-line-n {
    font-family: 'Comfortaa', sans-serif; font-size: .68rem; opacity: .4;
    min-width: 2.5rem; flex: 0 0 auto;
  }
  .od-note { font-size: .85rem; opacity: .75; max-width: 40rem; }
  .od-dl { display: flex; gap: .6rem; }
  .od-dl a {
    font-size: .8rem; padding: .45rem 1rem; border-radius: 999px; text-decoration: none;
    border: 1px solid var(--color-accent); color: var(--color-primary);
  }
  .od-dl a:hover { background: var(--color-accent); }
</style>

<script>
  // One place decides the axis settings; everything that shows the face reads it from there.
  const root = document.documentElement;
  const sliders = document.querySelectorAll<HTMLInputElement>('[data-axis]');
  const sizeIn = document.querySelector<HTMLInputElement>('[data-size]');
  const sample = document.querySelector<HTMLElement>('.od-sample');
  const outs = {
    wght: document.querySelector<HTMLOutputElement>('[data-out="wght"]'),
    push: document.querySelector<HTMLOutputElement>('[data-out="push"]'),
    size: document.querySelector<HTMLOutputElement>('[data-out="size"]'),
  };

  function apply(): void {
    const v: Record<string, number> = {};
    sliders.forEach((s) => { v[s.dataset.axis!] = Number(s.value); });
    root.style.setProperty('--od-var', `"wght" ${v.wght}, "PUSH" ${v.push}`);
    document.querySelectorAll<HTMLElement>('.od-sample, .od-row, .od-line, .od-head h1')
      .forEach((el) => { el.style.fontVariationSettings = `"wght" ${v.wght}, "PUSH" ${v.push}`; });
    if (outs.wght) outs.wght.value = String(v.wght);
    if (outs.push) outs.push.value = String(v.push);
    // a preset is "on" only while both axes still match it
    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
      b.setAttribute('aria-pressed',
        String(Number(b.dataset.wght) === v.wght && Number(b.dataset.push) === v.push));
    });
  }

  sliders.forEach((s) => s.addEventListener('input', apply));
  sizeIn?.addEventListener('input', () => {
    if (sample) sample.style.fontSize = `${sizeIn.value}px`;
    if (outs.size) outs.size.value = sizeIn.value;
  });
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
    b.addEventListener('click', () => {
      sliders.forEach((s) => {
        const key = s.dataset.axis === 'wght' ? 'wght' : 'push';
        s.value = b.dataset[key]!;
      });
      apply();
    });
  });

  if (sample && sizeIn) sample.style.fontSize = `${sizeIn.value}px`;
  apply();
</script>
