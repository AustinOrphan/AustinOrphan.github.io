---
// Demo route for the animated mark. Not linked from navigation.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import LogoAnimated from '../components/LogoAnimated.astro';
---
<BaseLayout title="Logo animation — Austin Orphan" description="The AO mark, written on."
            bodyClass="logo-anim-demo" robots="noindex, nofollow">
  <main class="la-demo">
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(480px, 42vw)" id="la-demo" class="la-demo-main" />
        <figcaption>LogoAnimated</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <Logo variant="hero" size="min(480px, 42vw)" />
        <figcaption>Logo (static)</figcaption>
      </figure>
    </div>
    <div class="la-demo-controls">
      <button type="button" class="la-demo-replay" data-la-replay>Replay</button>
      <label class="la-demo-scrub">
        <span>Scrub</span>
        <input type="range" min="0" max="1300" step="1" value="1300" data-la-scrub>
        <output data-la-time>1.30s</output>
      </label>
    </div>
    <div class="la-demo-row la-demo-small">
      <LogoAnimated variant="hero" size={44} id="la-demo-s1" />
      <LogoAnimated variant="flat" size={28} id="la-demo-s2" />
      <LogoAnimated variant="flat" size={120} id="la-demo-s3" />
      <span class="la-demo-note">44 / 28 / 120 px</span>
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(300px, 26vw)" id="la-treat-on" class="la-treat-on" />
        <figcaption>variant="hero" — outline and shadow</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="plain" size="min(300px, 26vw)" id="la-treat-off" class="la-treat-off" />
        <figcaption>variant="plain" — neither</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="flat" size="min(300px, 26vw)" id="la-treat-flat" class="la-treat-flat" />
        <figcaption>variant="flat" — accent fill</figcaption>
      </figure>
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-half" class="la-sp-half" speed={0.5} />
        <figcaption>speed=0.5 — 2.60s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-one" class="la-sp-one" />
        <figcaption>speed=1 — 1.30s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-two" class="la-sp-two" speed={2} />
        <figcaption>speed=2 — 0.65s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-col" class="la-col" ink="#EEE5E9" outline="#2892D7" shadow="#D16666" />
        <figcaption>ink / outline / shadow swapped</figcaption>
      </figure>
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(400px, 34vw)" id="la-mode-swash" class="la-mode-swash" trail="swash" />
        <figcaption>trail="swash" (default)</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(400px, 34vw)" id="la-mode-stroke" class="la-mode-stroke" trail="stroke" />
        <figcaption>trail="stroke" (what the clip draws)</figcaption>
      </figure>
    </div>

    <!-- One configured mark, exported. The controls drive both previews, so what you set is
         what the file gets: treatment and colours are the component's own props expressed as
         classes and custom properties, and speed and trail belong to the animated one. -->
    <section class="la-dl" aria-labelledby="la-dl-h">
      <h2 id="la-dl-h">Download</h2>

      <div class="la-dl-controls">
        <label>treatment
          <select data-dl-treat>
            <option value="hero">hero — ink, outline, shadow</option>
            <option value="plain">plain — ink only</option>
            <option value="flat">flat — one fill</option>
          </select>
        </label>
        <label>ink <input type="color" data-dl-var="ink" value="#EEE5E9"></label>
        <label data-dl-when="hero">outline <input type="color" data-dl-var="outline" value="#D16666"></label>
        <label data-dl-when="hero">shadow <input type="color" data-dl-var="shadow" value="#2892D7"></label>
        <label>speed <input type="number" data-dl-speed min="0.25" max="4" step="0.25" value="1"></label>
        <button type="button" data-dl-reset>reset</button>
      </div>

      <div class="la-dl-row">
        <figure class="la-dl-cell">
          <Logo variant="hero" size={132} id="la-dl-still" />
          <figcaption>still</figcaption>
          <div class="la-dl-btns">
            <button type="button" data-dl="svg" data-sel="#la-dl-still" data-name="ao-mark">SVG</button>
            <button type="button" data-dl="png" data-sel="#la-dl-still" data-name="ao-mark" data-size="512">512</button>
            <button type="button" data-dl="png" data-sel="#la-dl-still" data-name="ao-mark" data-size="1024">1024</button>
          </div>
        </figure>
        <figure class="la-dl-cell">
          <LogoAnimated variant="hero" size={132} id="la-dl-sw" class="la-dl-live" />
          <figcaption>animated</figcaption>
          <div class="la-dl-btns">
            <button type="button" data-dl="anim" data-name="ao-mark-animated">SVG</button>
            <button type="button" data-dl="video" data-name="ao-mark" data-slow="1">video</button>
            <button type="button" data-dl="video" data-name="ao-mark-slow" data-slow="4">&frac14;&times;</button>
            <button type="button" data-dl-replay>replay</button>
          </div>
        </figure>
      </div>

      <p class="la-dl-note">
        One vector, three treatments. <em>plain</em> and <em>flat</em> are the same drawing and
        differ only in fill, so setting <em>ink</em> makes them identical. SVG files carry their
        paint on the elements themselves and need no stylesheet; the animated file carries the
        write-on's own CSS and plays when opened. All are transparent, so a light ink wants a
        dark background &mdash; the video is given one.
      </p>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .logo-anim-demo {
    background: var(--color-background);
    color: var(--color-primary);
    min-height: 100vh;
    margin: 0;
  }
  .la-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 1rem 3rem;
    font-family: 'Comfortaa', sans-serif;
  }
  .la-demo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 3rem;
  }
  .la-demo-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .la-demo-cell figcaption {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .la-demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .la-demo-replay {
    font: inherit;
    font-weight: 700;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 2px solid var(--color-accent);
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
  }
  .la-demo-replay:hover { background: var(--color-accent); }
  .la-demo-scrub {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .la-demo-scrub input { width: 16rem; }
  .la-demo-scrub output {
    font-variant-numeric: tabular-nums;
    min-width: 3.5em;
  }
  .la-demo-small { gap: 1.5rem; }
  .la-demo-note { font-size: 0.8rem; opacity: 0.6; }
</style>

<script>
  import { downloadSvg, downloadPng, downloadVideo, videoMimeType } from '../components/logo-download';
  // Replay by re-applying the class that carries the animations. Every
  // LogoAnimated on the page restarts together.
  const marks = Array.from(document.querySelectorAll<SVGSVGElement>('.site-logo-anim'));
  const animationsOf = (el: Element) =>
    document.getAnimations().filter((a) => {
      const target = (a.effect as KeyframeEffect | null)?.target;
      return target instanceof Element && el.contains(target);
    });

  const replay = () => {
    for (const m of marks) {
      m.classList.remove('la-play');
      void m.getBoundingClientRect();
      m.classList.add('la-play');
    }
  };
  document.querySelector('[data-la-replay]')?.addEventListener('click', replay);
  (window as unknown as { __laReplay: () => void }).__laReplay = replay;

  // Scrubber: pause the big mark's animations and seek them. Replay resumes.
  const scrub = document.querySelector<HTMLInputElement>('[data-la-scrub]');
  const time = document.querySelector<HTMLOutputElement>('[data-la-time]');
  const big = marks[0];
  scrub?.addEventListener('input', () => {
    if (!big) return;
    big.classList.add('la-play');
    const ms = Number(scrub.value);
    for (const a of animationsOf(big)) {
      a.pause();
      a.currentTime = ms;
    }
    if (time) time.value = `${(ms / 1000).toFixed(2)}s`;
  });

  // ---- Downloads -----------------------------------------------------------------
  // The controls write to the two previews, and the export reads whatever is on them, so
  // there is one source of truth: treatment is a class swap, colours and speed are custom
  // properties, and trail is a choice between two instances because the two draw different
  // markup and cannot be switched with a property.
  const TREATMENTS = ['hero', 'plain', 'flat'] as const;
  const still = document.querySelector<SVGSVGElement>('#la-dl-still');
  const live = document.querySelector<SVGSVGElement>('#la-dl-sw');
  const treatSel = document.querySelector<HTMLSelectElement>('[data-dl-treat]');
  const speedIn = document.querySelector<HTMLInputElement>('[data-dl-speed]');
  const colourIns = Array.from(document.querySelectorAll<HTMLInputElement>('[data-dl-var]'));

  const liveMark = (): SVGSVGElement | null => live;

  function apply(): void {
    const treat = treatSel?.value ?? 'hero';
    const marks: (SVGSVGElement | null)[] = [still, live];
    for (const el of marks) {
      if (!el) continue;
      for (const t of TREATMENTS) {
        el.classList.toggle(`site-logo-${t}`, t === treat);
        if (el !== still) el.classList.toggle(`site-logo-anim-${t}`, t === treat);
      }
      for (const input of colourIns) el.style.setProperty(`--logo-${input.dataset.dlVar}`, input.value);
      if (el !== still) el.style.setProperty('--la-speed', String(speedIn?.value || 1));
    }
    // outline and shadow exist only on hero, so hide the controls that would do nothing
    document.querySelectorAll<HTMLElement>('[data-dl-when]').forEach((el) => {
      el.hidden = el.dataset.dlWhen !== treat;
    });
  }

  const replayLive = (): void => {
    const m = liveMark();
    if (!m) return;
    m.classList.remove('la-play');
    void m.getBoundingClientRect();
    m.classList.add('la-play');
  };

  [treatSel, speedIn, ...colourIns].forEach((el) =>
    el?.addEventListener('input', () => { apply(); replayLive(); }));
  document.querySelector('[data-dl-reset]')?.addEventListener('click', () => {
    if (treatSel) treatSel.value = 'hero';
    if (speedIn) speedIn.value = '1';
    colourIns.forEach((i) => { i.value = i.defaultValue; });
    apply(); replayLive();
  });
  document.querySelector('[data-dl-replay]')?.addEventListener('click', replayLive);
  apply();

  // Safari has only recently been able to record at all; say so rather than fail on click.
  if (!videoMimeType()) {
    document.querySelectorAll<HTMLButtonElement>('[data-dl="video"]').forEach((b) => {
      b.disabled = true;
      b.title = 'this browser cannot record video';
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-dl]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const src = btn.dataset.sel ? document.querySelector(btn.dataset.sel) : liveMark();
      if (!(src instanceof SVGSVGElement)) { console.error('no mark for', btn.dataset.sel); return; }
      const treat = treatSel?.value ?? 'hero';
      const name = `${btn.dataset.name || 'ao-mark'}-${treat}`;
      const kind = btn.dataset.dl;
      const was = btn.textContent;
      const done = (label: string) => {
        btn.textContent = label;
        btn.disabled = true;
        setTimeout(() => { btn.textContent = was; btn.disabled = false; }, 1200);
      };
      try {
        if (kind === 'svg') { downloadSvg(src, `${name}.svg`); done('saved'); }
        else if (kind === 'anim') { downloadSvg(src, `${name}.svg`, { animated: true }); done('saved'); }
        else if (kind === 'png') {
          btn.disabled = true;
          await downloadPng(src, `${name}-${btn.dataset.size}.png`, Number(btn.dataset.size || 1024));
          done('saved');
        } else if (kind === 'video') {
          btn.disabled = true;
          btn.textContent = 'baking';
          await downloadVideo(src, name, {
            slow: Number(btn.dataset.slow || 1), size: 512, fps: 30, background: '#1D2B35',
            onProgress: (d, t) => { btn.textContent = `${Math.round((d / t) * 100)}%`; },
          });
          done('saved');
        }
      } catch (err) {
        console.error(err);
        done('failed');
      }
    });
  });
</script>

<style is:global>
  .la-dl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(238 229 233 / 0.15);
    width: min(100%, 60rem);
  }
  .la-dl h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .la-dl-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
  }
  .la-dl-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .la-dl-cell figcaption { font-size: 0.8rem; opacity: 0.75; text-align: center; line-height: 1.4; }
  .la-dl-cell figcaption small { font-size: 0.72rem; opacity: 0.75; }
  .la-dl-btns { display: flex; gap: 0.4rem; }
  .la-dl-btns button {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--color-accent);
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
    min-width: 3.4rem;
  }
  .la-dl-btns button:hover:not(:disabled) { background: var(--color-accent); }
  .la-dl-btns button:disabled { opacity: 0.6; cursor: default; }
  .la-dl-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.4rem;
    font-size: 0.8rem;
  }
  .la-dl-controls label { display: flex; align-items: center; gap: 0.45rem; opacity: 0.85; }
  .la-dl-controls select,
  .la-dl-controls input[type="number"] {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.28rem 0.45rem;
    border-radius: 0.4rem;
    border: 1px solid rgb(238 229 233 / 0.3);
    background: var(--color-background);
    color: var(--color-primary);
  }
  .la-dl-controls input[type="number"] { width: 4.2rem; }
  .la-dl-controls input[type="color"] {
    width: 2rem; height: 1.6rem; padding: 0; cursor: pointer;
    border: 1px solid rgb(238 229 233 / 0.3); border-radius: 0.3rem; background: transparent;
  }
  .la-dl-controls [data-dl-reset] {
    font: inherit; font-size: 0.78rem; padding: 0.3rem 0.8rem; border-radius: 999px;
    border: 1px solid rgb(238 229 233 / 0.3); background: transparent;
    color: var(--color-primary); cursor: pointer;
  }
  .la-dl-anim {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .la-dl-anim label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; opacity: 0.8; }
  .la-dl-anim select {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.4rem;
    border: 1px solid rgb(238 229 233 / 0.3);
    background: var(--color-background);
    color: var(--color-primary);
  }
  .la-dl-note {
    margin: 0;
    /* the page's global paragraph rule paints this accent blue otherwise */
    color: var(--color-primary);
    max-width: 44rem;
    text-align: center;
    font-size: 0.8rem;
    opacity: 0.6;
    line-height: 1.5;
  }
</style>
