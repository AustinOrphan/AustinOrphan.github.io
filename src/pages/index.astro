---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import KonamiEgg from '../components/KonamiEgg.astro';
import ParticleSystem from '../components/ParticleSystem.astro';
import ProjectsMenu from '../components/ProjectsMenu.astro';
import Logo from '../components/Logo.astro';
---
<BaseLayout>
  <!-- Hero Section -->
  <section id="hero" class="hero-section">
    <div class="hero-logo-backdrop" aria-hidden="true"><Logo variant="flat" /></div>
    <div class="page-wrapper">
      <div class="content-wrapper">
        <h1 data-particle-target>Austin Orphan</h1>
        <p id="cbar">
          Creative <span class="divider"> | </span>Competitive <span class="divider"> | </span> Curious
        </p>
        <div id="linkBar">
          <a href="https://github.com/austinorphan" target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile">
            <i class="icon ph-duotone ph-github-logo"></i>
          </a>
          <a href="https://www.linkedin.com/in/austinorphan/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile">
            <i class="icon ph-duotone ph-linkedin-logo"></i>
          </a>
          <a href="/AustinOrphanResume.pdf" download aria-label="Download Resume">
            <i class="icon ph-duotone ph-read-cv-logo"></i>
          </a>
          <a href="mailto:AustinGOrphan@gmail.com" aria-label="Email Contact">
            <i class="icon ph-duotone ph-envelope-simple"></i>
          </a>
          <a href="/blog/" aria-label="Blog">
            <i class="icon ph-duotone ph-notepad"></i>
          </a>
          <ProjectsMenu />
        </div>
      </div>
      <div class="scroll-indicator">
        <a href="#about" aria-label="Scroll to About">
          <i class="ph-duotone ph-arrow-down"></i>
        </a>
      </div>
    </div>
  </section>

  <About />
  <Projects />
  <Contact />
  <Footer />

  <!-- Navigation -->
  <nav class="section-nav">
    <a href="#hero" aria-label="Go to Hero Section"><i class="ph-duotone ph-house"></i></a>
    <a href="#about" aria-label="Go to About Section"><i class="ph-duotone ph-user"></i></a>
    <a href="#projects" aria-label="Go to Projects Section"><i class="ph-duotone ph-folder-open"></i></a>
    <a href="#contact" aria-label="Go to Contact Section"><i class="ph-duotone ph-envelope"></i></a>
  </nav>

  <KonamiEgg />
  <ParticleSystem />

  <script>
    (function() {
      const projectCards = document.querySelectorAll('.project-card');
      const contactElements = document.querySelectorAll('.contact-method');

      projectCards.forEach((el, i) => { el.classList.add('scroll-reveal'); el.style.transitionDelay = `${i * 0.1}s`; });
      // Stagger within each about block, so the longer experience list doesn't trail off
      const aboutElements = ['.detail-section', '.skill-category', '.experience-item'].flatMap(sel => {
        const els = Array.from(document.querySelectorAll(sel));
        els.forEach((el, i) => {
          el.classList.add('scroll-reveal');
          el.style.transitionDelay = `${Math.min(i, 4) * 0.08}s`;
        });
        return els;
      });
      contactElements.forEach((el, i) => { el.classList.add('scroll-reveal'); el.style.transitionDelay = `${i * 0.08}s`; });

      let lastScrollY = window.pageYOffset;
      let scrollSpeed = 0;
      let speedTimeout;

      function calcScrollSpeed() {
        const cur = window.pageYOffset;
        scrollSpeed = Math.abs(cur - lastScrollY);
        lastScrollY = cur;
        clearTimeout(speedTimeout);
        speedTimeout = setTimeout(() => { scrollSpeed = 0; }, 150);
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (scrollSpeed > 30) entry.target.classList.add('fast-reveal');
            requestAnimationFrame(() => entry.target.classList.add('revealed'));
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      [...projectCards, ...aboutElements, ...contactElements].forEach(el => observer.observe(el));

      const DESKTOP_MQ = window.matchMedia('(min-width: 600px)');
      let isDesktop = DESKTOP_MQ.matches;

      const heroContent = document.querySelector('.content-wrapper');
      const linkBar = document.querySelector('#linkBar');
      const heroBackdrop = document.querySelector('.hero-logo-backdrop');
      const heroSection = document.querySelector('.hero-section');
      const REDUCED_MQ = window.matchMedia('(prefers-reduced-motion: reduce)');

      // .hero-section is overflow: hidden, the crop that keeps the oversized
      // backdrop mark in check. On a wide-but-short viewport, which is every
      // landscape phone, the link bar clears the hero's bottom edge by as
      // little as 10px, so an unbounded parallax pushes the icons straight
      // through that crop and slices them off. Measure the real headroom and
      // never drift past it. Measured with the transform cleared so the value
      // does not depend on the current scroll position.
      // offsetTop and offsetHeight are used rather than getBoundingClientRect
      // because they ignore transforms. The bar starts under the entrance
      // animation's translateY(50px) scale(0.95), so a rect-based measurement
      // taken at load reads 50px short and clamps the slack to zero, which
      // silently kills the parallax instead of bounding it.
      let heroSlack = 0;
      function measureHeroSlack() {
        if (!heroSection || !linkBar) return;
        let barBottom = linkBar.offsetHeight;
        for (let node = linkBar; node && node !== heroSection; node = node.offsetParent) {
          barBottom += node.offsetTop;
        }
        heroSlack = Math.max(0, heroSection.offsetHeight - barBottom - 6);
      }

      // Both branches below write inline styles the other never clears, and the
      // reset is itself gated on isDesktop, so nothing unwinds them when the
      // breakpoint flips. A .content-wrapper transform left over from landscape
      // is not merely a 40px nudge: a non-none transform makes the wrapper the
      // containing block for fixed descendants, and #linkBar is fixed below
      // 600px, so its `bottom` starts resolving against a 130px box instead of
      // the hero and the pill jumps some 415px up the page, landing on top of
      // the wordmark.
      DESKTOP_MQ.addEventListener('change', e => {
        isDesktop = e.matches;
        if (heroContent) heroContent.style.transform = '';
        if (linkBar) {
          linkBar.style.transform = '';
          linkBar.style.opacity = '';
          linkBar.style.pointerEvents = '';
        }
        measureHeroSlack();
        updateOnScroll();
      });

      measureHeroSlack();
      window.addEventListener('resize', measureHeroSlack);

      // The entrance animations below are applied with fill: forwards, and a
      // filling animation outranks inline style in the cascade. That silently
      // killed everything the scroll handler writes to this element: the mobile
      // fade-out never faded and the desktop lag never lagged. Hand the end
      // state to a class once the reveal finishes, so inline styles win again.
      linkBar?.addEventListener('animationend', () => {
        linkBar.style.animation = 'none';
        linkBar.classList.add('is-revealed');
        measureHeroSlack();
      });

      let ticking = false;
      function updateOnScroll() {
        const scrolled = window.pageYOffset;
        const heroHeight = window.innerHeight;
        calcScrollSpeed();
        if (scrolled < heroHeight) {
          if (heroContent && isDesktop) {
            heroContent.style.transform =
              `translateY(${Math.min(scrolled * 0.25, heroSlack)}px)`;
          }
          // Negative: the backdrop leads the scroll and exits through the top of
          // the viewport, rather than lagging down into the hero's bottom crop.
          if (heroBackdrop && !REDUCED_MQ.matches) {
            heroBackdrop.style.setProperty('--backdrop-shift', `${-scrolled * 0.25}px`);
          }
          // Desktop had a translateY(scrolled * 0.1) here. It never ran, for the
          // same fill: forwards reason, and switching it on now would change a
          // look nobody has complained about: it lags the bar to 0.64x the page
          // against the rest of the hero content's 0.75x. Left off deliberately.
          if (linkBar && !isDesktop) {
            const faded = Math.max(0, 1 - scrolled / heroHeight);
            linkBar.style.opacity = faded;
            // Once it is mostly gone it must stop swallowing taps, or a nearly
            // invisible bar sits over the About copy intercepting them.
            linkBar.style.pointerEvents = faded < 0.15 ? 'none' : '';
          }
        } else {
          if (heroContent) heroContent.style.transform = '';
          if (heroBackdrop) heroBackdrop.style.removeProperty('--backdrop-shift');
          if (linkBar && !isDesktop) {
            linkBar.style.opacity = '0';
            linkBar.style.pointerEvents = 'none';
          }
        }
        sectionNav?.classList.add('show-on-scroll');
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => sectionNav?.classList.remove('show-on-scroll'), 3000);
        updateActiveSection();
        ticking = false;
      }
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(updateOnScroll); ticking = true; }
      }, { passive: true });

      setTimeout(() => {
        const h1 = document.querySelector('h1');
        const cbar = document.querySelector('#cbar');
        if (h1) h1.style.animation = 'slideInScale 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards';
        if (cbar) cbar.style.animation = 'slideInScale 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards';
        if (linkBar) {
          linkBar.style.animation = isDesktop
            ? 'slideInScale 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.4s forwards'
            : 'fadeInOnly 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.4s forwards';
        }
      }, 300);

      const projectButtons = document.querySelectorAll('.project-links a');
      function triggerRandomFlash() {
        const num = Math.floor(Math.random() * 3) + 1;
        const shuffled = Array.from(projectButtons).sort(() => Math.random() - 0.5);
        for (let i = 0; i < num && i < shuffled.length; i++) {
          const delay = i * 0.5 + Math.random() * 2;
          const btn = shuffled[i];
          setTimeout(() => {
            btn.classList.add('flashing');
            setTimeout(() => btn.classList.remove('flashing'), 2000);
          }, delay * 1000);
        }
        setTimeout(triggerRandomFlash, 5000 + Math.random() * 10000);
      }
      setTimeout(triggerRandomFlash, 3000);

      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.section-nav a');
      const sectionNav = document.querySelector('.section-nav');
      let scrollTimeout;

      function updateActiveSection() {
        const pos = window.scrollY + window.innerHeight / 2;
        sections.forEach((section, i) => {
          if (pos >= section.offsetTop && pos < section.offsetTop + section.offsetHeight) {
            navLinks.forEach(l => l.classList.remove('active'));
            navLinks[i]?.classList.add('active');
          }
        });
      }

      document.addEventListener('mousemove', e => {
        if (window.innerWidth - e.clientX <= 80) {
          sectionNav?.classList.add('show-on-scroll');
        } else if (!sectionNav?.matches(':hover')) {
          sectionNav?.classList.remove('show-on-scroll');
        }
      });

      navLinks.forEach(link => link.addEventListener('click', () => setTimeout(updateActiveSection, 100)));
      updateActiveSection();
    })();
  </script>
</BaseLayout>
