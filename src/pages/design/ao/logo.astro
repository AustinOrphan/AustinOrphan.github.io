---
// The AO mark, explained: the animated component beside its static twin, every named
// treatment, the two trail modes, and the three places the mark actually sits on the site
// at their real sizes. Everything here is the real component's own output, never a mock-up.
//
// The instrument that CONFIGURES and exports a mark is a separate page,
// /design/ao/logo-bench/. The seam is publication versus instrument: different audiences,
// and opposite answers to whether they should ever be public. Splitting on it dissolved four
// of the five hazards the merged page had accumulated, each of which existed only because
// two documents had become one. Reasoning in
// docs/superpowers/specs/2026-09-20-logo-page-split-design.md.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Logo from '../../../components/Logo.astro';
import LogoAnimated from '../../../components/LogoAnimated.astro';
import Hero from '../../../components/Hero.astro';
import WipBanner from '../../../components/WipBanner.astro';
import DesignShell from '../../../components/DesignShell.astro';
import { entryFor, robotsFor } from '../../../data/design-index';
import { endMs } from '../../../components/logo-timing';
import { LOGO_LAYERS, LOGO_VARIANTS } from '../../../components/logo-layers';

const entry = entryFor('logo');


// Derived, never typed in. Every duration on this page comes from logo-choreography.ts by
// way of logo-timing.ts, because the choreography is generated and moves whenever the mark
// does. These had drifted to 1300/1100 against a real 1360/1160.
const HERO_MS = endMs('hero');
const secs = (ms: number) => (ms / 1000).toFixed(2);

// What each named variant actually turns on, written from the layer table rather than
// restated, so a variant added to logo-layers.ts cannot go undescribed here.
const VARIANT_RECIPE: Record<string, string> = Object.fromEntries(
  LOGO_VARIANTS.map((v) => {
    const { outline, shadow } = LOGO_LAYERS[v];
    return [v, ['ink', outline && 'outline', shadow && 'shadow'].filter(Boolean).join(' + ')];
  }),
);
---

<BaseLayout title={entry.title} description={entry.blurb}
            bodyClass="logo-anim-demo" robots={robotsFor(entry.status)}>
  <DesignShell />
  {entry.status === 'wip' && <WipBanner />}
  <h1 class="la-title">{entry.title}</h1>
  <section class="la-demo" aria-label="The mark, live">
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(480px, 42vw)" id="la-demo" class="la-demo-main" />
        <figcaption>LogoAnimated</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <Logo variant="hero" size="min(480px, 42vw)" />
        <figcaption>Logo (static)</figcaption>
      </figure>
    </div>
    <div class="la-demo-controls">
      <button type="button" class="la-demo-replay" data-la-replay>Replay</button>
      <label class="la-demo-scrub">
        <span>Scrub</span>
        <input type="range" min="0" max={HERO_MS} step="1" value={HERO_MS} data-la-scrub>
        <output data-la-time>{secs(HERO_MS)}s</output>
      </label>
    </div>
    <div class="la-demo-row la-demo-small">
      <LogoAnimated variant="hero" size={44} id="la-demo-s1" />
      <LogoAnimated variant="plain" size={28} id="la-demo-s2" />
      <LogoAnimated variant="plain" size={120} id="la-demo-s3" />
      <span class="la-demo-note">44 / 28 / 120 px</span>
    </div>
    <div class="la-demo-row">
      {LOGO_VARIANTS.map((v) => (
        <figure class="la-demo-cell">
          <LogoAnimated variant={v} size="min(240px, 21vw)" id={`la-treat-${v}`} class={`la-treat-${v}`} />
          <figcaption>variant="{v}" — {VARIANT_RECIPE[v]}</figcaption>
        </figure>
      ))}
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-half" class="la-sp-half" speed={0.5} />
        <figcaption>speed=0.5 — {secs(endMs('hero', 0.5))}s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-one" class="la-sp-one" />
        <figcaption>speed=1 — {secs(HERO_MS)}s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-two" class="la-sp-two" speed={2} />
        <figcaption>speed=2 — {secs(endMs('hero', 2))}s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-col" class="la-col" ink="#EEE5E9" outline="#2892D7" shadow="#D16666" />
        <figcaption>ink / outline / shadow swapped</figcaption>
      </figure>
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(400px, 34vw)" id="la-mode-swash" class="la-mode-swash" trail="swash" />
        <figcaption>trail="swash" (default)</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(400px, 34vw)" id="la-mode-stroke" class="la-mode-stroke" trail="stroke" />
        <figcaption>trail="stroke" (what the clip draws)</figcaption>
      </figure>
    </div>

  </section>

  <main class="lab">
    <section class="lab-situ">
      <h2>In the places the mark already sits</h2>
      <p class="lab-hint">
        Real sizes and real surroundings, so the small ones can be judged where they
        actually have to work. Each replays on click.
      </p>

      <figure class="situ situ-nav">
        <figcaption>blog nav — <code>variant="hero" size=&#123;26&#125;</code></figcaption>
        <div class="situ-frame">
          <nav class="blog-site-nav">
            <a href="#" class="blog-nav-home" data-situ>
              <LogoAnimated variant="hero" size={26} autoplay={false} id="situ-nav" />Austin Orphan
            </a>
            <span class="nav-sep">/</span>
            <a href="#">Blog</a>
          </nav>
        </div>
      </figure>

      <figure class="situ situ-footer">
        <figcaption>footer — <code>variant="hero" size=&#123;44&#125;</code></figcaption>
        <div class="situ-frame">
          <div class="situ-footer-row">
            <span data-situ><LogoAnimated variant="hero" size={44} autoplay={false} id="situ-footer" /></span>
            <span class="situ-dim">© 2026 Austin Orphan</span>
          </div>
        </div>
      </figure>

      <figure class="situ situ-hero">
        <figcaption>
          hero backdrop — the <em>real</em> hero (src/components/Hero.astro, the same one
          index.astro renders), with its backdrop drawn by LogoAnimated
        </figcaption>
        <div class="situ-frame situ-hero-frame" data-situ>
          <Hero>
            <LogoAnimated slot="backdrop" variant="plain" autoplay={false} id="situ-hero" />
          </Hero>
        </div>
        <p class="lab-hint">
          The backdrop is forced visible here. On the live page it is opacity 0 for the whole
          write-on — the draw finishes about a second before anything shows — so using it there
          needs the play triggered on reveal rather than on load.
        </p>
      </figure>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .logo-anim-demo {
    background: var(--color-background);
    color: var(--color-primary);
    min-height: 100vh;
    margin: 0;
    /* For the full-bleed hero panel below. 100vw counts the scrollbar and the page always
       has one, so without this it would overflow by the scrollbar's width. `clip` rather
       than `hidden` so no scroll container is created. */
    overflow-x: clip;
  }
  .la-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 1rem 3rem;
    font-family: 'Comfortaa', sans-serif;
  }
  .la-demo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 3rem;
  }
  .la-demo-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .la-demo-cell figcaption {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .la-demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .la-demo-replay {
    font: inherit;
    font-weight: 700;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 2px solid var(--color-accent);
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
  }
  .la-demo-replay:hover { background: var(--color-accent); }
  .la-demo-scrub {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .la-demo-scrub input { width: 16rem; }
  .la-demo-scrub output {
    font-variant-numeric: tabular-nums;
    min-width: 3.5em;
  }
  .la-demo-small { gap: 1.5rem; }
  .la-demo-note { font-size: 0.8rem; opacity: 0.6; }
</style>

<style is:global>
  .situ { margin: 22px 0 0; }
  .situ figcaption { font-size: 0.8rem; color: rgba(var(--color-primary-rgb), 0.6); margin-bottom: 6px; }
  .situ code { font-size: 0.76rem; color: rgba(var(--color-primary-rgb), 0.8); }
  .situ-frame {
    border: 1px solid rgba(var(--color-primary-rgb), 0.12); border-radius: 8px;
    background: var(--color-background); padding: 14px 18px; cursor: pointer;
    position: relative;
  }
  /* The real .blog-site-nav is position:fixed, so dropped in here it escapes the
     frame and pins itself to the top of the lab. Everything else about it is left
     alone -- the point is to judge the 26px mark against the nav's own type and
     spacing, not a re-creation of them. */
  .situ-frame .blog-site-nav {
    position: static; padding: 0; border-bottom: 0; background: none; z-index: auto;
  }
  .situ-footer-row { display: flex; align-items: center; gap: 16px; }
  .situ-dim { color: rgba(var(--color-primary-rgb), 0.5); font-size: 0.82rem; }
  /* The real hero is full-height and its backdrop is revealed by index.astro's own
     scroll handler, which does not run here — so it is forced visible and the section
     is scaled down to sit in a panel. Everything else is the hero's own CSS. */
  /* Full-bleed, and that is the point rather than a flourish. The hero sizes its wordmark
     with 14vw -- the VIEWPORT's width -- so penning it into the 1180px article column makes
     it render something the live page never shows: above about 1856px the wordmark wraps to
     two lines, "Orphan" is clipped by the frame, and the tagline and link bar are pushed out
     of it entirely. A panel whose whole claim is "the real hero" cannot misreport it at the
     widest viewports. Giving the frame the viewport's own width makes 14vw resolve against
     the width the hero actually has.

     overflow-x: clip on the page rather than hidden: it does not create a scroll container,
     so it absorbs the scrollbar's width without changing how anything else scrolls. */
  .situ-hero-frame {
    padding: 0; overflow: hidden; position: relative;
    width: 100vw; margin-left: calc(50% - 50vw); border-radius: 0; border-left: 0; border-right: 0;
  }
  .situ-hero-frame .hero-section { min-height: 0; height: 78vh; }
  .situ-hero-frame .scroll-indicator { display: none; }
  /* Three things the real page does with script or chrome that the panel has to
     stand in for. None of them touch the mark itself, which is the thing being
     judged here; they are called out so the panel is not mistaken for the live
     page's behaviour.
       1. index.astro's own script writes style.animation on the h1 and #cbar to
          reveal them; global.css holds both at opacity 0 until it does.
       2. the backdrop is revealed by that same script, and stays at opacity 0
          through the whole write-on on the live page (see the note above).
       3. #linkBar is position:fixed, so inside a panel it pins itself to the
          viewport instead of sitting in the hero. */
  .situ-hero-frame .hero-section h1,
  .situ-hero-frame .hero-section #cbar { opacity: 1; }
  .situ-hero-frame .hero-logo-backdrop { opacity: 0.34; }
  .situ-hero-frame #linkBar { position: static; margin-top: 28px; opacity: 1; transform: none; }
</style>

<script>
  import { downloadSvg, downloadPng, downloadVideo, videoMimeType } from '../../../components/logo-download';
  // Replay by re-applying the class that carries the animations. Every
  // LogoAnimated in the DEMO restarts together.
  //
  // Scoped to .la-demo, not document-wide. Before the merge this page was the whole
  // document, so a bare '.site-logo-anim' meant "the demo's marks". It now also matches
  // the lab's six stage slots and three in-situ marks, which ship autoplay={false} on
  // purpose, so Replay animated panels nobody clicked and restarted the lab's mark out
  // from under its own scrub slider. Same class of leak the data-lab-size rename fixed.
  const marks = Array.from(document.querySelectorAll<SVGSVGElement>('.la-demo .site-logo-anim'));
  const animationsOf = (el: Element) =>
    document.getAnimations().filter((a) => {
      const target = (a.effect as KeyframeEffect | null)?.target;
      return target instanceof Element && el.contains(target);
    });

  const replay = () => {
    for (const m of marks) {
      m.classList.remove('la-play');
      void m.getBoundingClientRect();
      m.classList.add('la-play');
    }
  };
  document.querySelector('[data-la-replay]')?.addEventListener('click', replay);
  (window as unknown as { __laReplay: () => void }).__laReplay = replay;

  // Scrubber: pause the big mark's animations and seek them. Replay resumes.
  const scrub = document.querySelector<HTMLInputElement>('[data-la-scrub]');
  const time = document.querySelector<HTMLOutputElement>('[data-la-time]');
  const big = marks[0];
  scrub?.addEventListener('input', () => {
    if (!big) return;
    big.classList.add('la-play');
    const ms = Number(scrub.value);
    for (const a of animationsOf(big)) {
      a.pause();
      a.currentTime = ms;
    }
    if (time) time.value = `${(ms / 1000).toFixed(2)}s`;
  });

  // The in-situ panels replay on click, at their own real sizes. They ship
  // autoplay={false}, so without this they never move and the caption's "Each replays on
  // click" is a lie -- which is what the split left behind for a while, because the handler
  // stayed with the lab while the panels came here.
  for (const holder of document.querySelectorAll<HTMLElement>('[data-situ]')) {
    const svg = holder.querySelector<SVGSVGElement>('svg');
    if (!svg) continue;
    const frame = holder.closest('.situ-frame') ?? holder;
    frame.addEventListener('click', (e) => {
      e.preventDefault();
      svg.classList.remove('la-play');
      void svg.getBoundingClientRect();          // force the restart
      svg.classList.add('la-play');
    });
  }
</script>
