    justify-content: center;
    gap: 1rem 1.4rem;
    font-size: 0.8rem;
  }
  .la-dl-controls label { display: flex; align-items: center; gap: 0.45rem; opacity: 0.85; }
  .la-dl-controls select,
  .la-dl-controls input[type="number"] {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.28rem 0.45rem;
    border-radius: 0.4rem;
    border: 1px solid rgb(238 229 233 / 0.3);
    background: var(--color-background);
    color: var(--color-primary);
  }
  .la-dl-controls input[type="number"] { width: 4.2rem; }
  .la-dl-controls input[type="color"] {
    width: 2rem; height: 1.6rem; padding: 0; cursor: pointer;
    border: 1px solid rgb(238 229 233 / 0.3); border-radius: 0.3rem; background: transparent;
  }
  .la-dl-controls [data-dl-reset] {
    font: inherit; font-size: 0.78rem; padding: 0.3rem 0.8rem; border-radius: 999px;
    border: 1px solid rgb(238 229 233 / 0.3); background: transparent;
    color: var(--color-primary); cursor: pointer;
  }
  .la-dl-anim {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
