</style>

<script>
  // The stage holds one rendered instance per (variant, trail); the controls reveal one.
  // Size, speed and the three colours are set on the SVG itself, not on a wrapper:
  // LogoAnimated declares --la-speed on .site-logo-anim, and a declaration on the element
  // beats a value inherited from an ancestor, so setting it on a parent would do nothing.
  import { endMs } from '../../../components/logo-timing';
import { LOGO_LAYERS, LOGO_VARIANTS } from '../../../components/logo-layers';

  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const slots = [...stage.querySelectorAll<HTMLElement>('.lab-slot')];
  const svgs = slots.map((s) => s.querySelector<SVGSVGElement>('svg')!);
  const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)!;
  const out = (name: string) => $<HTMLOutputElement>(`[data-out="${name}"]`);

  // What each combination is FOR, keyed by the name the layers resolve to. The duration is
  // appended at render time rather than written into the prose, so these cannot fall out of
  // step with the choreography the way the old "(1.30s)" had.
  const HINT: Record<string, string> = {
    hero: 'off-white ink, red outline, blue offset — the site h1, and the nav and footer marks',
    plain: 'ink alone, and what the hero backdrop asks for',
    outlined: 'the red edge without the offset copy',
    shadowed: 'the offset copy without the red edge',
  };

  const state = {
    outline: true, shadow: true, trail: 'swash', size: 280, speed: 1,
    ink: '', outlineCol: '', shadowCol: '', loop: false,
    band: 300, sdist: 42.4264069, sangle: 45, sscale: 1,
  };

  /** The name for the layers currently on. All four combinations have one. */
  const variantName = (): string =>
    LOGO_VARIANTS.find((v) => LOGO_LAYERS[v].outline === state.outline
                           && LOGO_LAYERS[v].shadow === state.shadow) ?? 'plain';

  const currentSvg = () => svgs[slots.findIndex((s) => s.dataset.trail === state.trail)];
  const totalMs = () => endMs(variantName(), state.speed);

  function apply() {
    slots.forEach((s) => { s.hidden = s.dataset.trail !== state.trail; });
    for (const svg of svgs) {
      svg.style.width = `${state.size}px`;
      svg.style.height = `${state.size}px`;
      svg.style.setProperty('--la-speed', String(state.speed));
      svg.classList.toggle('logo-layer-outline', state.outline);
      svg.classList.toggle('logo-layer-shadow', state.shadow);
      svg.style.setProperty('--logo-band', String(state.band));
      svg.style.setProperty('--logo-shadow-dist', String(state.sdist));
      svg.style.setProperty('--logo-shadow-angle', `${state.sangle}deg`);
      svg.style.setProperty('--logo-shadow-scale', String(state.sscale));
      for (const [k, v] of Object.entries({ ink: state.ink, outline: state.outlineCol, shadow: state.shadowCol })) {
        if (v) svg.style.setProperty(`--logo-${k}`, v);
        else svg.style.removeProperty(`--logo-${k}`);
      }
    }
    // A parameter's fieldset is hidden while its layer is off, so nothing on screen is a
    // control that would do nothing.
    document.querySelectorAll<HTMLElement>('[data-when-layer]').forEach((el) => {
      el.hidden = !state[el.dataset.whenLayer as 'outline' | 'shadow'];
    });
    out('size').value = `${state.size}px`;
    out('speed').value = `${state.speed.toFixed(2)}× · ${(totalMs() / 1000).toFixed(2)}s`;
    // Half the stroke width: the stroke straddles the silhouette and the fill covers its
    // inner half, so this is the red you can actually see.
    out('band').value = state.band === 0 ? 'none' : String(state.band / 2);
    out('sdist').value = `${state.sdist.toFixed(1)}`;
    out('sangle').value = `${state.sangle}°`;
    out('sscale').value = `${state.sscale.toFixed(2)}×`;
    const rad = (state.sangle * Math.PI) / 180;
    // `+ 0` folds -0 into 0: cos(270deg) is -1.8e-16, which toFixed renders as "-0.0".
    const axis = (n: number) => (Number(n.toFixed(1)) + 0).toFixed(1);
    $<HTMLElement>('[data-shadow-hint]').textContent =
      `offset (${axis(state.sdist * Math.cos(rad))}, ${axis(state.sdist * Math.sin(rad))}) ` +
      `in viewBox units, y down`;
    const name = variantName();
    // The hint describes the combination, so it carries its own length at speed 1; the speed
    // readout above is the one that tracks the slider.
    $<HTMLElement>('[data-variant-hint]').textContent =
      `${name} — ${HINT[name]} (${(endMs(name) / 1000).toFixed(2)}s)`;
    const scrub = $<HTMLInputElement>('input[name="scrub"]');
    scrub.max = String(totalMs());
    scrub.value = scrub.max;
    out('scrub').value = `${(totalMs() / 1000).toFixed(3)}s`;
  }

  function play(svg: SVGSVGElement) {
    svg.classList.remove('la-play');
    void svg.getBoundingClientRect();                       // force the restart
    svg.classList.add('la-play');
  }

  function pause() {
    for (const a of currentSvg().getAnimations({ subtree: true })) a.pause();
  }

  $<HTMLElement>('[data-play]').addEventListener('click', () => play(currentSvg()));
  $<HTMLElement>('[data-pause]').addEventListener('click', pause);
  $<HTMLInputElement>('[data-loop]').addEventListener('change', (e) => {
    state.loop = (e.target as HTMLInputElement).checked;
    if (state.loop) play(currentSvg());
  });

  // Looping: the component drops la-play once every animation has finished, which is
  // exactly the moment to start again.
  for (const svg of svgs) {
    svg.addEventListener('animationend', () => {
      if (!state.loop || svg !== currentSvg()) return;
      if (svg.getAnimations({ subtree: true }).every((a) => a.playState === 'finished')) {
        setTimeout(() => { if (state.loop) play(svg); }, 260);
      }
    });
  }

  for (const c of document.querySelectorAll<HTMLInputElement>('input[name="layer"]')) {
    c.addEventListener('change', () => {
      state[c.value as 'outline' | 'shadow'] = c.checked;
      apply();
      play(currentSvg());
    });
  }
  for (const r of document.querySelectorAll<HTMLInputElement>('input[name="trail"]')) {
    r.addEventListener('change', () => { state.trail = r.value; apply(); play(currentSvg()); });
  }
  $<HTMLInputElement>('input[name="size"]').addEventListener('input', (e) => {
    state.size = Number((e.target as HTMLInputElement).value); apply();
  });
  $<HTMLInputElement>('input[name="speed"]').addEventListener('input', (e) => {
    state.speed = Number((e.target as HTMLInputElement).value); apply();
  });
  $<HTMLInputElement>('input[name="scrub"]').addEventListener('input', (e) => {
    const svg = currentSvg();
    if (!svg.classList.contains('la-play')) play(svg);
    const ms = Number((e.target as HTMLInputElement).value);
    for (const a of svg.getAnimations({ subtree: true })) { a.pause(); a.currentTime = ms; }
    out('scrub').value = `${(ms / 1000).toFixed(3)}s`;
  });
  // The colour inputs are named for the layer they paint; state keys them with a Col suffix
  // so they do not collide with the booleans of the same name.
  for (const [input, key] of [['ink', 'ink'], ['outline', 'outlineCol'], ['shadow', 'shadowCol']] as const) {
    $<HTMLInputElement>(`input[name="${input}"]`).addEventListener('input', (e) => {
      state[key] = (e.target as HTMLInputElement).value; apply();
    });
  }
  // The treatment parameters. Each replays, because what they change only settles in after
  // the draw lands and is otherwise invisible until the next run.
  for (const [input, key] of [['band', 'band'], ['sdist', 'sdist'], ['sangle', 'sangle'],
                              ['sscale', 'sscale']] as const) {
    $<HTMLInputElement>(`input[name="${input}"]`).addEventListener('input', (e) => {
      state[key] = Number((e.target as HTMLInputElement).value); apply();
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-band]')) {
    b.addEventListener('click', () => {
      state.band = Number(b.dataset.band);
      $<HTMLInputElement>('input[name="band"]').value = String(state.band);
      apply(); play(currentSvg());
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-lab-size]')) {
    b.addEventListener('click', () => {
      state.size = Number(b.dataset.labSize);
      $<HTMLInputElement>('input[name="size"]').value = String(state.size); apply();
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-speed]')) {
    b.addEventListener('click', () => {
      state.speed = Number(b.dataset.speed);
      $<HTMLInputElement>('input[name="speed"]').value = String(state.speed);
      apply(); play(currentSvg());
    });
  }
  const PALETTES: Record<string, [string, string, string]> = {
    theme: ['', '', ''],
    swap: ['#EEE5E9', '#2892D7', '#D16666'],
    mono: ['#EEE5E9', '#8fa0ad', '#4a5c6a'],
  };
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-colours]')) {
    b.addEventListener('click', () => {
      const [i, o, s] = PALETTES[b.dataset.colours!];
      state.ink = i; state.outlineCol = o; state.shadowCol = s;
      if (i) $<HTMLInputElement>('input[name="ink"]').value = i;
      if (o) $<HTMLInputElement>('input[name="outline"]').value = o;
      if (s) $<HTMLInputElement>('input[name="shadow"]').value = s;
      apply();
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-bg]')) {
    b.addEventListener('click', () => { stage.dataset.bg = b.dataset.bg!; });
  }

  // The in-situ panels replay on click, at their own real sizes.
  for (const holder of document.querySelectorAll<HTMLElement>('[data-situ]')) {
    const svg = holder.querySelector<SVGSVGElement>('svg')!;
    const frame = holder.closest('.situ-frame') ?? holder;
    frame.addEventListener('click', (e) => { e.preventDefault(); play(svg); });
  }

  apply();
  play(currentSvg());
</script>

<script>
  import { downloadSvg, downloadPng, downloadVideo, videoMimeType } from '../../../components/logo-download';
  // Replay by re-applying the class that carries the animations. Every
  // LogoAnimated in the DEMO restarts together.
  //
  // Scoped to .la-demo, not document-wide. Before the merge this page was the whole
  // document, so a bare '.site-logo-anim' meant "the demo's marks". It now also matches
  // the lab's six stage slots and three in-situ marks, which ship autoplay={false} on
  // purpose, so Replay animated panels nobody clicked and restarted the lab's mark out
  // from under its own scrub slider. Same class of leak the data-lab-size rename fixed.
  const marks = Array.from(document.querySelectorAll<SVGSVGElement>('.la-demo .site-logo-anim'));
  const animationsOf = (el: Element) =>
    document.getAnimations().filter((a) => {
      const target = (a.effect as KeyframeEffect | null)?.target;
      return target instanceof Element && el.contains(target);
    });

  const replay = () => {
    for (const m of marks) {
      m.classList.remove('la-play');
      void m.getBoundingClientRect();
      m.classList.add('la-play');
    }
  };
  document.querySelector('[data-la-replay]')?.addEventListener('click', replay);
  (window as unknown as { __laReplay: () => void }).__laReplay = replay;

  // Scrubber: pause the big mark's animations and seek them. Replay resumes.
  const scrub = document.querySelector<HTMLInputElement>('[data-la-scrub]');
  const time = document.querySelector<HTMLOutputElement>('[data-la-time]');
  const big = marks[0];
  scrub?.addEventListener('input', () => {
    if (!big) return;
    big.classList.add('la-play');
    const ms = Number(scrub.value);
    for (const a of animationsOf(big)) {
      a.pause();
      a.currentTime = ms;
    }
    if (time) time.value = `${(ms / 1000).toFixed(2)}s`;
  });

  // ---- Downloads -----------------------------------------------------------------
  // The controls write to the two previews, and the export reads whatever is on them, so
  // there is one source of truth: treatment is a class swap, colours and speed are custom
  // properties, and trail is a choice between two instances because the two draw different
  // markup and cannot be switched with a property.
  import { LOGO_LAYERS, LOGO_VARIANTS, type LogoVariant } from '../../../components/logo-layers';

  const still = document.querySelector<SVGSVGElement>('#la-dl-still');
  const live = document.querySelector<SVGSVGElement>('#la-dl-sw');
  const treatSel = document.querySelector<HTMLSelectElement>('[data-dl-treat]');
  const speedIn = document.querySelector<HTMLInputElement>('[data-dl-speed]');
  const sizeSel = document.querySelector<HTMLSelectElement>('[data-dl-size]');
  const colourIns = Array.from(document.querySelectorAll<HTMLInputElement>('[data-dl-var]'));
  const liveMark = (): SVGSVGElement | null => live;
  const size = (): number => Number(sizeSel?.value || 512);

  const treatment = (): LogoVariant => {
    const v = treatSel?.value as LogoVariant | undefined;
    return v && LOGO_VARIANTS.includes(v) ? v : 'hero';
  };

  function apply(): void {
    const layers = LOGO_LAYERS[treatment()];
    const marks: (SVGSVGElement | null)[] = [still, live];
    for (const el of marks) {
      if (!el) continue;
      // The layer classes ARE the mechanism; the variant name is only a preset over them.
      // This used to swap `site-logo-<variant>` classes, which stopped meaning anything when
      // the rules moved onto the layers. Both components resolve a variant the same way, so
      // the still and the animated preview stay in step with no second mapping here.
      el.classList.toggle('logo-layer-outline', layers.outline);
      el.classList.toggle('logo-layer-shadow', layers.shadow);
      for (const input of colourIns) el.style.setProperty(`--logo-${input.dataset.dlVar}`, input.value);
      if (el !== still) el.style.setProperty('--la-speed', String(speedIn?.value || 1));
    }
    // A colour control is shown only while its layer is on, so nothing can be set to no effect
    document.querySelectorAll<HTMLElement>('[data-dl-layer]').forEach((el) => {
      const layer = el.dataset.dlLayer as keyof typeof layers;
      el.hidden = !layers[layer];
    });
  }

  const replayLive = (): void => {
    const m = liveMark();
    if (!m) return;
    m.classList.remove('la-play');
    void m.getBoundingClientRect();
    m.classList.add('la-play');
  };

  [treatSel, speedIn, sizeSel, ...colourIns].forEach((el) =>
    el?.addEventListener('input', () => { apply(); replayLive(); }));
  document.querySelector('[data-dl-reset]')?.addEventListener('click', () => {
    if (treatSel) treatSel.value = 'hero';
    if (speedIn) speedIn.value = '1';
    if (sizeSel) sizeSel.value = '512';
    colourIns.forEach((i) => { i.value = i.defaultValue; });
    apply(); replayLive();
  });
  document.querySelector('[data-dl-replay]')?.addEventListener('click', replayLive);
  apply();

  // Safari has only recently been able to record at all; say so rather than fail on click.
  if (!videoMimeType()) {
    document.querySelectorAll<HTMLButtonElement>('[data-dl="video"]').forEach((b) => {
      b.disabled = true;
      b.title = 'this browser cannot record video';
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-dl]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const src = btn.dataset.sel ? document.querySelector(btn.dataset.sel) : liveMark();
      if (!(src instanceof SVGSVGElement)) { console.error('no mark for', btn.dataset.sel); return; }
      const name = `${btn.dataset.name || 'ao-mark'}-${treatment()}`;
      const kind = btn.dataset.dl;
      const was = btn.textContent;
      const done = (label: string) => {
        btn.textContent = label;
        btn.disabled = true;
        setTimeout(() => { btn.textContent = was; btn.disabled = false; }, 1200);
      };
      const px = size();
      try {
        if (kind === 'svg') { downloadSvg(src, `${name}.svg`, { size: px }); done('saved'); }
        else if (kind === 'anim') { downloadSvg(src, `${name}.svg`, { animated: true, size: px }); done('saved'); }
        else if (kind === 'png') {
          btn.disabled = true;
          await downloadPng(src, `${name}-${px}.png`, px);
          done('saved');
        } else if (kind === 'video') {
          btn.disabled = true;
          btn.textContent = 'baking';
          // Capped: every frame is baked and rasterised up front, so 2048 turns a 1.3s clip
          // into a minute of work for a size no one plays a logo animation at.
          await downloadVideo(src, name, {
            slow: Number(btn.dataset.slow || 1), size: Math.min(px, 1024), fps: 30,
            background: '#1D2B35',
            onProgress: (d, t) => { btn.textContent = `${Math.round((d / t) * 100)}%`; },
          });
          done('saved');
        }
      } catch (err) {
        console.error(err);
        done('failed');
      }
    });
  });
</script>
