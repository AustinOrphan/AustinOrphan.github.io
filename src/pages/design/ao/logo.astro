---
// The AO mark: the animated component beside its static twin, the three places
// the logo actually appears on the site at their real sizes, and every prop as
// a live control.
//
// The variant and trail props are build-time, so each (variant, trail) pair is
// rendered once and the controls show one and hide the rest. Everything else,
// size, speed and the three colours, is a custom property or an attribute set
// live on the chosen instance. That way the thing on screen is the real
// component's own output and not a mock-up of it.
//
// Merged from the former /logo-animation/ and /logo-lab/ pages. Both style
// blocks are keyed on their original body classes, so the body carries both.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Logo from '../../../components/Logo.astro';
import LogoAnimated from '../../../components/LogoAnimated.astro';
import Hero from '../../../components/Hero.astro';
import WipBanner from '../../../components/WipBanner.astro';
import { entryFor, robotsFor } from '../../../data/design-index';
import { endMs } from '../../../components/logo-timing';
import { LOGO_LAYERS, LOGO_VARIANTS } from '../../../components/logo-layers';

const entry = entryFor('logo');

const VARIANTS = LOGO_VARIANTS;
const TRAILS = ['swash', 'stroke'] as const;

// Derived, never typed in. Every duration on this page comes from logo-choreography.ts by
// way of logo-timing.ts, because the choreography is generated and moves whenever the mark
// does. These had drifted to 1300/1100 against a real 1360/1160.
const HERO_MS = endMs('hero');
const secs = (ms: number) => (ms / 1000).toFixed(2);

// What each named variant actually turns on, written from the layer table rather than
// restated, so a variant added to logo-layers.ts cannot go undescribed here.
const VARIANT_RECIPE: Record<string, string> = Object.fromEntries(
  LOGO_VARIANTS.map((v) => {
    const { outline, shadow } = LOGO_LAYERS[v];
    return [v, ['ink', outline && 'outline', shadow && 'shadow'].filter(Boolean).join(' + ')];
  }),
);
---

<BaseLayout title={entry.title} description={entry.blurb}
            bodyClass="logo-lab logo-anim-demo" robots={robotsFor(entry.status)}>
  {entry.status === 'wip' && <WipBanner />}
  <h1 class="la-title">{entry.title}</h1>
  <section class="la-demo" aria-label="The mark, live">
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(480px, 42vw)" id="la-demo" class="la-demo-main" />
        <figcaption>LogoAnimated</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <Logo variant="hero" size="min(480px, 42vw)" />
        <figcaption>Logo (static)</figcaption>
      </figure>
    </div>
    <div class="la-demo-controls">
      <button type="button" class="la-demo-replay" data-la-replay>Replay</button>
      <label class="la-demo-scrub">
        <span>Scrub</span>
        <input type="range" min="0" max={HERO_MS} step="1" value={HERO_MS} data-la-scrub>
        <output data-la-time>{secs(HERO_MS)}s</output>
      </label>
    </div>
    <div class="la-demo-row la-demo-small">
      <LogoAnimated variant="hero" size={44} id="la-demo-s1" />
      <LogoAnimated variant="plain" size={28} id="la-demo-s2" />
      <LogoAnimated variant="plain" size={120} id="la-demo-s3" />
      <span class="la-demo-note">44 / 28 / 120 px</span>
    </div>
    <div class="la-demo-row">
      {LOGO_VARIANTS.map((v) => (
        <figure class="la-demo-cell">
          <LogoAnimated variant={v} size="min(240px, 21vw)" id={`la-treat-${v}`} class={`la-treat-${v}`} />
          <figcaption>variant="{v}" — {VARIANT_RECIPE[v]}</figcaption>
        </figure>
      ))}
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-half" class="la-sp-half" speed={0.5} />
        <figcaption>speed=0.5 — {secs(endMs('hero', 0.5))}s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-one" class="la-sp-one" />
        <figcaption>speed=1 — {secs(HERO_MS)}s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-sp-two" class="la-sp-two" speed={2} />
        <figcaption>speed=2 — {secs(endMs('hero', 2))}s</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(220px, 20vw)" id="la-col" class="la-col" ink="#EEE5E9" outline="#2892D7" shadow="#D16666" />
        <figcaption>ink / outline / shadow swapped</figcaption>
      </figure>
    </div>
    <div class="la-demo-row">
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(400px, 34vw)" id="la-mode-swash" class="la-mode-swash" trail="swash" />
        <figcaption>trail="swash" (default)</figcaption>
      </figure>
      <figure class="la-demo-cell">
        <LogoAnimated variant="hero" size="min(400px, 34vw)" id="la-mode-stroke" class="la-mode-stroke" trail="stroke" />
        <figcaption>trail="stroke" (what the clip draws)</figcaption>
      </figure>
    </div>

    <!-- One configured mark, exported. The controls drive both previews, so what you set is
         what the file gets: treatment and colours are the component's own props expressed as
         classes and custom properties, and speed and trail belong to the animated one. -->
    <section class="la-dl" aria-labelledby="la-dl-h">
      <h2 id="la-dl-h">Download</h2>

      <div class="la-dl-controls">
        <label>treatment
          <select data-dl-treat>
            {LOGO_VARIANTS.map((v) => (
              <option value={v} selected={v === 'hero'}>{v} — {VARIANT_RECIPE[v]}</option>
            ))}
          </select>
        </label>
        <label>ink <input type="color" data-dl-var="ink" value="#EEE5E9"></label>
        <!-- Each colour control is shown only while its LAYER is on, so it cannot be set to
             something that has no effect. Keyed on the layer, not on the variant name, which
             is what let outline and shadow hide on the two combinations that now have names. -->
        <label data-dl-layer="outline">outline <input type="color" data-dl-var="outline" value="#D16666"></label>
        <label data-dl-layer="shadow">shadow <input type="color" data-dl-var="shadow" value="#2892D7"></label>
        <label>size
          <select data-dl-size>
            <option value="256">256</option>
            <option value="512" selected>512</option>
            <option value="1024">1024</option>
            <option value="2048">2048</option>
          </select>
        </label>
        <label>speed <input type="number" data-dl-speed min="0.25" max="4" step="0.25" value="1"></label>
        <button type="button" data-dl-reset>reset</button>
      </div>

      <div class="la-dl-row">
        <figure class="la-dl-cell">
          <Logo variant="hero" size={132} id="la-dl-still" />
          <figcaption>still</figcaption>
          <div class="la-dl-btns">
            <button type="button" data-dl="svg" data-sel="#la-dl-still" data-name="ao-mark">SVG</button>
            <button type="button" data-dl="png" data-sel="#la-dl-still" data-name="ao-mark">PNG</button>
          </div>
        </figure>
        <figure class="la-dl-cell">
          <LogoAnimated variant="hero" size={132} id="la-dl-sw" class="la-dl-live" />
          <figcaption>animated</figcaption>
          <div class="la-dl-btns">
            <button type="button" data-dl="anim" data-name="ao-mark-animated">SVG</button>
            <button type="button" data-dl="video" data-name="ao-mark" data-slow="1">video</button>
            <button type="button" data-dl="video" data-name="ao-mark-slow" data-slow="4">&frac14;&times;</button>
            <button type="button" data-dl-replay>replay</button>
          </div>
        </figure>
      </div>

      <p class="la-dl-note">
        One vector, three treatments. <em>plain</em> and <em>flat</em> are the same drawing and
        differ only in fill, so <em>ink</em> follows the treatment until you set it yourself;
        set them alike and the two files are identical. <em>size</em> drives every download
        (the video caps at 1024); <em>speed</em> reaches the animated SVG and the video, which
        the still has no use for. SVG files carry their paint on the elements themselves and
        need no stylesheet, and hero's outline is saved as its own shape rather than leaning on
        a <code>paint-order</code> that design tools ignore; the animated file carries the
        write-on's own CSS and plays when opened. All are transparent, so a light ink wants a
        dark background &mdash; the video is given one.
      </p>
    </section>
  </section>
  <main class="lab">
    <section class="lab-stage-wrap">
      <!-- One instance per TRAIL, and only per trail: the two draw different markup and
           cannot be switched with a property. Everything else, layers included, is now a
           class or a custom property set live, so this used to be eight slots and is two. -->
      <div class="lab-stage" data-stage data-bg="site">
        {TRAILS.map((t) => (
          <div class="lab-slot" data-trail={t} hidden>
            <LogoAnimated trail={t} size={280} autoplay={false} id={`lab-${t}`} />
          </div>
        ))}
      </div>

      <div class="lab-controls">
        <!-- Layers, not variants. Two booleans are four combinations and all four are named,
             so a row of variant radios would be a second control over the same two bits and
             the two would drift. The toggles are the state; the name is derived from them. -->
        <fieldset>
          <legend>layers</legend>
          <label><input type="checkbox" name="layer" value="outline" checked /> outline</label>
          <label><input type="checkbox" name="layer" value="shadow" checked /> shadow</label>
          <p class="lab-hint" data-variant-hint></p>
        </fieldset>

        <fieldset>
          <legend>trail</legend>
          {TRAILS.map((t, i) => (
            <label><input type="radio" name="trail" value={t} checked={i === 0} /> {t}</label>
          ))}
        </fieldset>

        <fieldset>
          <legend>size</legend>
          <label class="lab-range">
            <input type="range" name="size" aria-label="size" min="16" max="520" step="1" value="280" />
            <output data-out="size">280px</output>
          </label>
          <div class="lab-presets">
            <button type="button" data-lab-size="26">26 blog nav</button>
            <button type="button" data-lab-size="44">44 footer</button>
            <button type="button" data-lab-size="120">120</button>
            <button type="button" data-lab-size="280">280</button>
          </div>
        </fieldset>

        <fieldset>
          <legend>speed</legend>
          <label class="lab-range">
            <input type="range" name="speed" aria-label="speed" min="0.25" max="4" step="0.05" value="1" />
            <output data-out="speed">1.00× · {secs(HERO_MS)}s</output>
          </label>
          <div class="lab-presets">
            <button type="button" data-speed="0.5">0.5</button>
            <button type="button" data-speed="1">1</button>
            <button type="button" data-speed="2">2</button>
            <button type="button" data-speed="3">3</button>
          </div>
        </fieldset>

        <fieldset>
          <legend>colour</legend>
          <label class="lab-colour"><span>ink</span><input type="color" name="ink" value="#EEE5E9" /></label>
          <label class="lab-colour"><span>outline</span><input type="color" name="outline" value="#D16666" /></label>
          <label class="lab-colour"><span>shadow</span><input type="color" name="shadow" value="#2892D7" /></label>
          <div class="lab-presets">
            <button type="button" data-colours="theme">theme</button>
            <button type="button" data-colours="swap">swap red/blue</button>
            <button type="button" data-colours="mono">mono</button>
          </div>
        </fieldset>

        <!-- The outline's weight. Reported as the VISIBLE band, which is half the stroke
             width, because the stroke straddles the silhouette and its inner half is covered
             by the fill. 300 is what hero has always drawn. -->
        <fieldset data-when-layer="outline">
          <legend>band</legend>
          <label class="lab-range">
            <input type="range" name="band" aria-label="band" min="0" max="1200" step="10" value="300" />
            <output data-out="band"></output>
          </label>
          <div class="lab-presets">
            <button type="button" data-band="150">150</button>
            <button type="button" data-band="300">300</button>
            <button type="button" data-band="600">600</button>
            <button type="button" data-band="1000">1000</button>
          </div>
          <p class="lab-hint">
            The visible band. The stroke is twice this and straddles the silhouette; its
            inner half is covered by the fill.
          </p>
        </fieldset>

        <!-- Polar, so the offset reads as a direction and a throw rather than two numbers.
             step="any" on the distance so the exact default survives being rendered into a
             slider: 30*sqrt(2) is not a multiple of any sane step. -->
        <fieldset data-when-layer="shadow">
          <legend>shadow offset</legend>
          <label class="lab-range">
            <span class="lab-tick">dist</span>
            <input type="range" name="sdist" aria-label="shadow distance" min="0" max="200" step="any" value="42.4264069" />
            <output data-out="sdist"></output>
          </label>
          <label class="lab-range">
            <span class="lab-tick">angle</span>
            <input type="range" name="sangle" aria-label="shadow angle" min="0" max="360" step="1" value="45" />
            <output data-out="sangle"></output>
          </label>
          <label class="lab-range">
            <span class="lab-tick">scale</span>
            <input type="range" name="sscale" aria-label="shadow scale" min="0.4" max="2" step="0.01" value="1" />
            <output data-out="sscale"></output>
          </label>
          <p class="lab-hint" data-shadow-hint></p>
        </fieldset>

        <fieldset>
          <legend>ground</legend>
          <div class="lab-presets">
            <button type="button" data-bg="site">site</button>
            <button type="button" data-bg="ink">near-black</button>
            <button type="button" data-bg="light">light</button>
            <button type="button" data-bg="accent">accent</button>
          </div>
        </fieldset>

        <fieldset>
          <legend>play</legend>
          <div class="lab-presets">
            <button type="button" data-play>replay</button>
            <button type="button" data-pause>pause</button>
          </div>
          <label><input type="checkbox" data-loop /> loop</label>
          <label class="lab-range">
            <input type="range" name="scrub" aria-label="scrub" min="0" max={HERO_MS} step="1" value={HERO_MS} />
            <output data-out="scrub">{(HERO_MS / 1000).toFixed(3)}s</output>
          </label>
          <p class="lab-hint">Scrubbing pauses. Replay resumes from the top.</p>
        </fieldset>
      </div>
    </section>

    <section class="lab-situ">
      <h2>In the places the mark already sits</h2>
      <p class="lab-hint">
        Real sizes and real surroundings, so the small ones can be judged where they
        actually have to work. Each replays on click.
      </p>

      <figure class="situ situ-nav">
        <figcaption>blog nav — <code>variant="hero" size=&#123;26&#125;</code></figcaption>
        <div class="situ-frame">
          <nav class="blog-site-nav">
            <a href="#" class="blog-nav-home" data-situ>
              <LogoAnimated variant="hero" size={26} autoplay={false} id="situ-nav" />Austin Orphan
            </a>
            <span class="nav-sep">/</span>
            <a href="#">Blog</a>
          </nav>
        </div>
      </figure>

      <figure class="situ situ-footer">
        <figcaption>footer — <code>variant="hero" size=&#123;44&#125;</code></figcaption>
        <div class="situ-frame">
          <div class="situ-footer-row">
            <span data-situ><LogoAnimated variant="hero" size={44} autoplay={false} id="situ-footer" /></span>
            <span class="situ-dim">© 2026 Austin Orphan</span>
          </div>
        </div>
      </figure>

      <figure class="situ situ-hero">
        <figcaption>
          hero backdrop — the <em>real</em> hero (src/components/Hero.astro, the same one
          index.astro renders), with its backdrop drawn by LogoAnimated
        </figcaption>
        <div class="situ-frame situ-hero-frame" data-situ>
          <Hero>
            <LogoAnimated slot="backdrop" variant="plain" autoplay={false} id="situ-hero" />
          </Hero>
        </div>
        <p class="lab-hint">
          The backdrop is forced visible here. On the live page it is opacity 0 for the whole
          write-on — the draw finishes about a second before anything shows — so using it there
          needs the play triggered on reveal rather than on load.
        </p>
      </figure>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .logo-lab { background: var(--color-background); color: var(--color-primary); }
  .lab { max-width: 1180px; margin: 0 auto; padding: 84px 24px 96px; }
  /* The page title sits above the demo rather than inside .lab, so that the document's
     first heading is this h1 and not the demo's "Download" h2. Styled by its own class,
     never by a descendant selector: the in-situ panel renders the real hero, whose own
     h1 must keep the bare `h1` rule in global.css. A `.lab h1` here outranked it and
     shrank the wordmark to 24px. The stroke and shadow resets are that same global rule
     in the other direction -- at 1400px it puts a 2.8px stroke on 24px text. */
  .la-title {
    max-width: 1180px; margin: 0 auto; padding: 84px 24px 0;
    font-size: 1.5rem; letter-spacing: 0.02em;
    -webkit-text-stroke: 0; text-shadow: none;
  }
  .lab > section > h2, .lab > h2 { font-size: 1.1rem; margin: 56px 0 8px; }
  .lab-hint { color: rgba(var(--color-primary-rgb), 0.55); font-size: 0.82rem; margin: 6px 0 0; }

  .lab-stage-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; align-items: start; }
  @media (max-width: 900px) { .lab-stage-wrap { grid-template-columns: 1fr; } }

  .lab-stage {
    display: grid; place-items: center; min-height: 560px; border-radius: 10px;
    border: 1px solid rgba(var(--color-primary-rgb), 0.12); overflow: hidden;
  }
  .lab-stage[data-bg="site"]   { background: var(--color-background); }
  .lab-stage[data-bg="ink"]    { background: #0b1116; }
  .lab-stage[data-bg="light"]  { background: #EEE5E9; }
  .lab-stage[data-bg="accent"] { background: var(--color-accent); }
  .lab-slot[hidden] { display: none; }

  .lab-controls { display: grid; gap: 14px; }
  .lab-controls fieldset {
    border: 1px solid rgba(var(--color-primary-rgb), 0.14); border-radius: 8px;
    padding: 10px 12px 12px; margin: 0; display: grid; gap: 8px;
  }
  .lab-controls legend { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: rgba(var(--color-primary-rgb), 0.55); padding: 0 4px; }
  .lab-controls label { display: flex; align-items: center; gap: 8px; font-size: 0.86rem; }
  .lab-range { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; }
  /* The shadow rows carry a name as well as a slider and a readout, so they need a third
     track; without this the readout wraps onto a line of its own. */
  .lab-range:has(.lab-tick) { grid-template-columns: 2.8rem 1fr auto; }
  .lab-tick { font-size: 0.72rem; opacity: 0.7; }
  .lab-range input[type="range"] { width: 100%; }
  .lab-range output { font-family: ui-monospace, monospace; font-size: 0.76rem;
    color: rgba(var(--color-primary-rgb), 0.7); min-width: 8ch; text-align: right; }
  .lab-colour { justify-content: space-between; }
  .lab-colour input[type="color"] { width: 46px; height: 24px; padding: 0; border: 0; background: none; }
  .lab-presets { display: flex; flex-wrap: wrap; gap: 6px; }
  .lab-presets button {
    font: inherit; font-size: 0.76rem; padding: 3px 9px; border-radius: 999px; cursor: pointer;
    color: var(--color-primary); background: transparent;
    border: 1px solid rgba(var(--color-primary-rgb), 0.28);
  }
  .lab-presets button:hover { border-color: var(--color-accent); color: var(--color-accent); }

  .situ { margin: 22px 0 0; }
  .situ figcaption { font-size: 0.8rem; color: rgba(var(--color-primary-rgb), 0.6); margin-bottom: 6px; }
  .situ code { font-size: 0.76rem; color: rgba(var(--color-primary-rgb), 0.8); }
  .situ-frame {
    border: 1px solid rgba(var(--color-primary-rgb), 0.12); border-radius: 8px;
    background: var(--color-background); padding: 14px 18px; cursor: pointer;
    position: relative;
  }
  /* The real .blog-site-nav is position:fixed, so dropped in here it escapes the
     frame and pins itself to the top of the lab. Everything else about it is left
     alone -- the point is to judge the 26px mark against the nav's own type and
     spacing, not a re-creation of them. */
  .situ-frame .blog-site-nav {
    position: static; padding: 0; border-bottom: 0; background: none; z-index: auto;
  }
  .situ-footer-row { display: flex; align-items: center; gap: 16px; }
  .situ-dim { color: rgba(var(--color-primary-rgb), 0.5); font-size: 0.82rem; }
  /* The real hero is full-height and its backdrop is revealed by index.astro's own
     scroll handler, which does not run here — so it is forced visible and the section
     is scaled down to sit in a panel. Everything else is the hero's own CSS. */
  .situ-hero-frame { padding: 0; overflow: hidden; position: relative; }
  .situ-hero-frame .hero-section { min-height: 0; height: 78vh; }
  .situ-hero-frame .scroll-indicator { display: none; }
  /* Three things the real page does with script or chrome that the panel has to
     stand in for. None of them touch the mark itself, which is the thing being
     judged here; they are called out so the panel is not mistaken for the live
     page's behaviour.
       1. index.astro's own script writes style.animation on the h1 and #cbar to
          reveal them; global.css holds both at opacity 0 until it does.
       2. the backdrop is revealed by that same script, and stays at opacity 0
          through the whole write-on on the live page (see the note above).
       3. #linkBar is position:fixed, so inside a panel it pins itself to the
          viewport instead of sitting in the hero. */
  .situ-hero-frame .hero-section h1,
  .situ-hero-frame .hero-section #cbar { opacity: 1; }
  .situ-hero-frame .hero-logo-backdrop { opacity: 0.34; }
  .situ-hero-frame #linkBar { position: static; margin-top: 28px; opacity: 1; transform: none; }
</style>

<style is:global>
  .logo-anim-demo {
    background: var(--color-background);
    color: var(--color-primary);
    min-height: 100vh;
    margin: 0;
  }
  .la-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 1rem 3rem;
    font-family: 'Comfortaa', sans-serif;
  }
  .la-demo-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 3rem;
  }
  .la-demo-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .la-demo-cell figcaption {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .la-demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .la-demo-replay {
    font: inherit;
    font-weight: 700;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 2px solid var(--color-accent);
    background: transparent;
    color: var(--color-primary);
    cursor: pointer;
  }
  .la-demo-replay:hover { background: var(--color-accent); }
  .la-demo-scrub {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .la-demo-scrub input { width: 16rem; }
  .la-demo-scrub output {
    font-variant-numeric: tabular-nums;
    min-width: 3.5em;
  }
  .la-demo-small { gap: 1.5rem; }
  .la-demo-note { font-size: 0.8rem; opacity: 0.6; }
</style>

<style is:global>
  .la-dl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(238 229 233 / 0.15);
    width: min(100%, 60rem);
  }
  .la-dl h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .la-dl-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
  }
  .la-dl-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
