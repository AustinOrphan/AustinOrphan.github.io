---
import '../styles/global.css';

// Single source of truth for the site-level description. Used by the schema.org
// Person below and as the default meta description. Pages may override the
// `description` prop for their own meta tags; the Person schema always describes
// the site owner, never the page, so it must not follow that prop.
const SITE_DESCRIPTION =
  'Software engineer. Fintech backend, plus shared LLM infrastructure. Projects, writing, and experiments.';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  bodyClass?: string;
  /** The page's robots directive. Pages that should stay out of search results
   *  pass their own value here rather than adding a second <meta name="robots">,
   *  which would leave two conflicting tags in the head. */
  robots?: string;
}

const {
  title = 'Austin Orphan',
  description = SITE_DESCRIPTION,
  canonicalURL: canonicalURLProp,
  bodyClass,
  robots = 'index,follow',
} = Astro.props;

const canonicalURL = canonicalURLProp ?? new URL(Astro.url.pathname, Astro.site).toString();

// A purpose-built landscape card, not an app icon. The icons in public/ are
// transparent PNGs, and scrapers flatten transparency onto white, which washed
// out the cyan mark. This is opaque, on-palette, and 1200x630 so it renders as
// a full-width card rather than a small square thumbnail.
const SOCIAL_IMAGE = 'https://austinorphan.com/og-image.png';
const SOCIAL_IMAGE_W = '1200';
const SOCIAL_IMAGE_H = '630';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Austin Orphan',
  url: 'https://austinorphan.com',
  sameAs: ['https://github.com/austinorphan', 'https://www.linkedin.com/in/austinorphan/'],
  jobTitle: 'Backend Software Engineer',
  description: SITE_DESCRIPTION,
  email: 'austin@austinorphan.com',
  knowsAbout: [
    'Backend Engineering',
    'Python',
    'SQL',
    'C#',
    'TypeScript',
    'PostgreSQL',
    'AI/LLM Platform Engineering',
    'LiteLLM',
    'Langfuse',
    'Vertex AI',
    'Retrieval-Augmented Generation',
    'Model Context Protocol',
    'Kubernetes',
  ],
  mainEntityOfPage: {
    '@type': 'WebSite',
    '@id': 'https://austinorphan.com',
  },
};

// set:html renders raw, so escape "<" as its JSON unicode form. JSON.stringify
// does not escape it, and a "</script>" sequence appearing in any value would
// otherwise terminate the tag early. Inert for the current author-controlled
// data; this keeps a future edit from being able to break the document.
const jsonLd = JSON.stringify(personSchema).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anta&family=Comfortaa:wght@700&family=Source+Sans+Pro:wght@900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Pixelify+Sans:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" defer></script>

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#2892D7">
  <meta name="msapplication-TileColor" content="#1D2B35">
  <meta name="theme-color" content="#1D2B35">

  <meta name="description" content={description}>
  <meta name="author" content="Austin Orphan">
  <meta name="robots" content={robots}>

  <meta property="og:url" content={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={SOCIAL_IMAGE}>
  <meta property="og:image:width" content={SOCIAL_IMAGE_W}>
  <meta property="og:image:height" content={SOCIAL_IMAGE_H}>
  <meta property="og:image:alt" content="Austin Orphan. Software engineer, fintech backend and shared LLM infrastructure.">
  <meta property="og:site_name" content="Austin Orphan Portfolio">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={SOCIAL_IMAGE}>
  <meta name="twitter:image:alt" content="Austin Orphan. Software engineer, fintech backend and shared LLM infrastructure.">

  <link rel="canonical" href={canonicalURL}>

  <script type="application/ld+json" set:html={jsonLd}></script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GL8J5KLG7C"></script>
  <script>
    // Google's own snippet, kept verbatim in shape. The declaration just tells
    // the checker about the globals it creates.
    declare global { interface Window { dataLayer: unknown[] } }
    const GA_ID = 'G-GL8J5KLG7C';
    window.dataLayer = window.dataLayer || [];
    function gtag(...args: unknown[]) { window.dataLayer.push(args); }
    gtag('js', new Date());
    gtag('config', GA_ID, {
      page_title: document.title,
      page_location: window.location.href
    });
  </script>

  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>
