---
// The site mark. One vector, three paint layers.
//
// Ink is always on. Outline and shadow are independent, which is two booleans and
// therefore four combinations. `variant` names them:
//
//   plain     ink
//   outlined  ink + outline
//   shadowed  ink + shadow
//   hero      ink + outline + shadow   (mirrors the desktop h1)
//
// It used to be a three-value enum -- hero, plain, flat -- over the same two booleans,
// which is why `plain` and `flat` collided (identical drawings differing only in which
// colour the fill fell back to) and why the middle two above had no name. `flat` is
// retired: its one real call site was the hero backdrop, where the fill is overridden by
// the heroLogoTint animation anyway, so its accent default was never seen.
//
// A variant is a preset, not the mechanism. It resolves to the layer classes below, and
// anything that wants a combination directly -- the bench -- toggles those classes.
//
// The three colours are custom properties (--logo-ink / --logo-outline / --logo-shadow)
// falling back to the theme, so an instance can be recoloured without a second component.
// The outline's weight is --logo-band.
// The variant table and the class mapping live in logo-layers.ts, not here: Astro does not
// treat frontmatter as an importable module surface, so LogoAnimated could not share them.
import { layerClasses, type LogoVariant } from './logo-layers';

interface Props {
  /** Hollow the outline: the fill goes and the band is cut out of the stroke, so the
   *  letterform is a hole rather than a shape. Needs `outline`; it is that layer's paint
   *  standing alone instead of sitting under the fill. */
  cut?: boolean;
  /** A field with the letterform punched out of it. Independent of everything else. */
  knock?: boolean;
  /** Ship the cut and knockout masks even when those layers are off, so they can be
   *  switched on later by swapping classes. Only the bench needs that. Every other instance
   *  would be carrying two more copies of the mark path -- about 10KB -- for masks it never
   *  references, which on the write-up's twenty-odd marks came to a fifth of the page. */
  treatable?: boolean;
  variant?: LogoVariant;
  size?: number | string;
  class?: string;
  /** For addressing one instance from script, as LogoAnimated already allows. */
  id?: string;
  ink?: string;
  outline?: string;
  shadow?: string;
}
import { LOGO_MARK_D, nextLogoAnimId } from './logo-mark';

const { variant = 'hero', size = 28, class: className = '', id, ink, outline, shadow,
        cut = false, knock = false, treatable = false } = Astro.props;
// Only ship the cut and knockout masks where they can actually be used. Each holds its own
// copy of the 3.3KB mark path, so an instance that never references them is carrying about
// 10KB for nothing -- which on the write-up's twenty-odd marks came to a fifth of the page.
const masks = cut || knock || treatable;
// The mask ids have to be unique per instance, and stable across builds: the counter in
// logo-mark.ts is module state, so it numbers in render order rather than at random.
const uid = id ?? nextLogoAnimId();
const extra = [cut && 'logo-layer-cut', knock && 'logo-layer-knock'].filter(Boolean).join(' ');
const px = typeof size === 'number' ? `${size}px` : size;
const vars = [ink && `--logo-ink:${ink}`, outline && `--logo-outline:${outline}`,
               shadow && `--logo-shadow:${shadow}`].filter(Boolean).join(';');
// The offset copy is always rendered, and the shadow layer's rule is what reveals it. It
// has to be in the markup either way, because the bench re-treats a mark by swapping
// classes and cannot add elements to one that shipped without them.
//
// No `site-logo-<variant>` class on the root: nothing keys on it now that the rules sit on
// the layers, and the bench re-treats a mark by toggling layers, so the variant name would
// stay on the element describing a treatment it no longer has.
---
<svg
  class={`site-logo ${layerClasses(variant)} ${extra} ${className}`.replace(/\s+/g, ' ').trim()}
  id={id}
  style={vars || undefined}
  viewBox="-70 -70 1246 1246"
  width={px}
  height={px}
  role="img"
  aria-hidden="true"
  focusable="false"
>
  {masks && (
    <defs>
      <!-- The band, as a shape rather than a stroke: white over the whole stroke, black over
           the glyph, so only the outer half of the stroke survives and the letterform is a
           clean hole. fill-rule leaves the counters white, which is right -- the band hugs
           them from the inside the same way it hugs the silhouette from the outside. -->
      <mask id={`${uid}-cut`} maskUnits="userSpaceOnUse" x="-1000" y="-1000" width="14000" height="14000">
        <path d={LOGO_MARK_D} fill="#fff" stroke="#fff" stroke-linejoin="round" class="site-logo-cut-mask" />
        <path d={LOGO_MARK_D} fill="#000" />
      </mask>
      <!-- Everything except the letterform. -->
      <mask id={`${uid}-knock`} maskUnits="userSpaceOnUse" x="-1000" y="-1000" width="14000" height="14000">
        <rect x="-1000" y="-1000" width="14000" height="14000" fill="#fff" />
        <path d={LOGO_MARK_D} fill="#000" />
      </mask>
    </defs>
  )}

  <g class="site-logo-shadow-holder">
    <g transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)" class="site-logo-shadow"><path d={LOGO_MARK_D} /></g>
  </g>
  {masks && (
    <g transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)" class="site-logo-knock-holder">
      <rect x="-1000" y="-1000" width="14000" height="14000" class="site-logo-knock" mask={`url(#${uid}-knock)`} />
    </g>
  )}
  {masks && (
    <g class="site-logo-shadow-knocked" mask={`url(#${uid}-knock)`}>
      <g transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)" class="site-logo-shadow"><path d={LOGO_MARK_D} /></g>
    </g>
  )}
  {masks && (
    <g
      transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)"
      class="site-logo-cut-holder"
      stroke-linejoin="round"
    ><path d={LOGO_MARK_D} mask={`url(#${uid}-cut)`} /></g>
  )}
  <g
    transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)"
    class="site-logo-mark"
    stroke-linejoin="round"
    paint-order="stroke fill markers"
  ><path d={LOGO_MARK_D} /></g>
</svg>
