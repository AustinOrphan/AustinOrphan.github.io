---
// The site mark. One vector, two treatments:
//   "hero" mirrors the desktop h1 (off-white fill, red outline, blue shadow)
//   "flat" is a single accent fill, for sizes where the outline goes sub-pixel
interface Props {
  variant?: 'hero' | 'flat';
  size?: number | string;
  class?: string;
}
import { LOGO_MARK_D } from './logo-mark';

const { variant = 'hero', size = 28, class: className = '' } = Astro.props;
const px = typeof size === 'number' ? `${size}px` : size;
---
<svg
  class={`site-logo site-logo-${variant} ${className}`.trim()}
  viewBox="-70 -70 1246 1246"
  width={px}
  height={px}
  role="img"
  aria-hidden="true"
  focusable="false"
>
  {variant === 'hero' && (
    <g transform="translate(22,22)">
      <g transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)" class="site-logo-shadow"><path d={LOGO_MARK_D} /></g>
    </g>
  )}
  <g
    transform="translate(0.000000,1084.000000) scale(0.100000,-0.100000)"
    class="site-logo-mark"
    stroke-width={variant === 'hero' ? 300 : 0}
    stroke-linejoin="round"
    paint-order="stroke fill markers"
  ><path d={LOGO_MARK_D} /></g>
</svg>
