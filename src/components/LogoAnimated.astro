<script>
  // Settle: once EVERY animation on this mark has finished, drop the playing class so the
  // resting markup is all that is left to paint. Keying on one named animation was fine while
  // the pieces switched off last, but the hero's outline and shadow now settle after them, and
  // dropping the class mid-flight would snap them to their end state.
  document.querySelectorAll<SVGSVGElement>('.site-logo-anim').forEach((svg) => {
    svg.addEventListener('animationend', () => {
      // subtree: true matters -- every animation here is on a DESCENDANT, so the bare
      // call returns an empty list and every() on it is vacuously true, which would
      // drop the class on the first animationend of the run.
      if (svg.getAnimations({ subtree: true }).every((a) => a.playState === 'finished')) {
        svg.classList.remove('la-play');
      }
    });
  });
</script>
