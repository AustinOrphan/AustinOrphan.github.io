                                <li class="skill-tag">Alembic</li>
                                <li class="skill-tag">.NET</li>
                                <li class="skill-tag">ASP.NET</li>
                            </ul>
                        </div>

                        <div class="skill-category">
                            <h4>AI/LLM Platform</h4>
                            <ul class="skill-tags" role="list">
                                <li class="skill-tag">LiteLLM</li>
                                <li class="skill-tag">Langfuse</li>
                                <li class="skill-tag">Vertex AI</li>
                                <li class="skill-tag">LLM Routing</li>
                                <li class="skill-tag">Prompt Management</li>
                                <li class="skill-tag">Prompt Caching</li>
                                <li class="skill-tag">Observability</li>
                            </ul>
                        </div>

                        <div class="skill-category">
                            <h4>Applied AI</h4>
                            <ul class="skill-tags" role="list">
                                <li class="skill-tag">RAG</li>
                                <li class="skill-tag">Vector Retrieval</li>
                                <li class="skill-tag">MCP</li>
                                <li class="skill-tag">Prompt Engineering</li>
                                <li class="skill-tag">Conversational AI</li>
                                <li class="skill-tag">Document Processing</li>
                            </ul>
                        </div>

                        <div class="skill-category">
                            <h4>Cloud &amp; Delivery</h4>
                            <ul class="skill-tags" role="list">
                                <li class="skill-tag">Kubernetes</li>
                                <li class="skill-tag">Argo CD</li>
                                <li class="skill-tag">AWS</li>
                                <li class="skill-tag">Google Cloud</li>
                                <li class="skill-tag">Git</li>
                                <li class="skill-tag">CI/CD</li>
                            </ul>
                        </div>

                        <div class="skill-category skill-category-secondary">
                            <h4>Also Worked With</h4>
                            <ul class="skill-tags" role="list">
                                <li class="skill-tag skill-tag-secondary">Java</li>
