---
import { projects } from '../data/projects';
---
<!-- Projects Section -->
<section id="projects" class="projects-section">
    <div class="section-container">
        <h2>Projects</h2>
        <div class="projects-grid">
            {projects.map((project) => (
                <div class={project.placeholder ? 'project-card placeholder' : 'project-card'}>
                    <div class="project-header">
                        <h3>{project.title}</h3>
                        <div class="project-links">
                            {project.demo && (
                                <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} Live Demo`}>
                                    <i class="ph-duotone ph-play-circle"></i>
                                </a>
                            )}
                            {project.repo && (
                                <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.title} on GitHub`}>
                                    <i class="ph-duotone ph-github-logo"></i>
                                </a>
                            )}
                        </div>
                    </div>
                    <div class="project-description">
                        <p>{project.description}</p>
                    </div>
                    <div class="project-tech">
                        {project.tech.map((tag) => <span class="tech-tag">{tag}</span>)}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
