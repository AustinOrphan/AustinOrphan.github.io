---
import Logo from './Logo.astro';

interface PostLink {
  title: string;
  id: string;
}

interface Props {
  /* "fixed" is the home page's parallax-revealed bar, pinned to the viewport
     bottom and faded in once the page scrolls past #contact. "static" is the
     same footer in normal flow at the end of a blog document, where there is
     no #contact to key a reveal to and a long post should not scroll
     underneath a permanent bar. */
  variant?: 'fixed' | 'static';
  prevPost?: PostLink;
  nextPost?: PostLink;
}

const { variant = 'fixed', prevPost, nextPost } = Astro.props;
const year = new Date().getFullYear();

/* Blog routes drop the Blog link, which would only point at the section you
   are already in. Getting home is the mark's job, so no link replaces it.
   Read off the URL rather than passed in, so no caller can get it wrong. */
const onBlog = Astro.url.pathname.startsWith('/blog');
---
<footer class:list={['site-footer', `site-footer--${variant}`]}>
    {(prevPost || nextPost) && (
        <nav class="footer-nav">
            {prevPost ? (
                <a href={`/blog/${prevPost.id}/`} class="footer-nav-prev">
                    <span class="footer-nav-label">← Previous</span>
                    <span class="footer-nav-title">{prevPost.title}</span>
                </a>
            ) : <span />}
            {nextPost ? (
                <a href={`/blog/${nextPost.id}/`} class="footer-nav-next">
                    <span class="footer-nav-label">Next →</span>
                    <span class="footer-nav-title">{nextPost.title}</span>
                </a>
            ) : <span />}
        </nav>
    )}
    <div class="footer-top">
        <button class="footer-return" aria-label="Back to top">
            <i class="ph-duotone ph-arrow-up"></i>
            <span>Top</span>
        </button>
    </div>
    <div class="footer-decoration">
        <div class="decoration-line-full"></div>
    </div>
    <div class="footer-content">
        <!-- Mark left, copyright right. One alternative was rendered and kept in
             mind: copyright left with the mark right (the original grid, where
             the mark reads as a corner afterthought).

             The mark is sized in CSS from --footer-mark, which tracks the
             buttons so it stays a step above one at every width. The 55 here
             is only the pre-CSS fallback, the value at the clamp's floor. -->
        <div class="footer-left">
            <a href="/" class="footer-mark-link" aria-label="Home">
                <Logo variant="hero" size={55} class="footer-logo" />
            </a>
        </div>
        <div class="footer-center">
            <!-- The same links, in the same order, as the hero's #linkBar,
                 minus home, which the mark to the left handles. The hero bar
                 is anchored to the hero and has scrolled far away by the time
                 this is on screen, and blog pages never render it at all, so
                 this is the only place the resume and the demos are reachable
                 from the bottom of a page.

                 The envelope goes to /#contact, not to a mailto:. Every
                 envelope on the site now means the same thing, and from a blog
                 post this is the only route to the contact form at all.

                 Projects is a plain link to /#projects, not the ProjectsMenu
                 component: that component takes the first [data-projects-menu]
                 in the document and owns the id "projects-menu-list", so a
                 second copy on the home page would render a menu that never
                 opens and duplicate an id that aria-controls points at. -->
            <div class="footer-profiles">
                <a href="https://github.com/austinorphan" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="footer-profile-link"><i class="ph-duotone ph-github-logo"></i></a>
                <a href="https://www.linkedin.com/in/austinorphan/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="footer-profile-link"><i class="ph-duotone ph-linkedin-logo"></i></a>
                <a href="/AustinOrphanResume.pdf" download aria-label="Download resume" class="footer-profile-link"><i class="ph-duotone ph-read-cv-logo"></i></a>
                <a href="/#contact" aria-label="Contact" class="footer-profile-link"><i class="ph-duotone ph-envelope-simple"></i></a>
                {!onBlog && (
                    <a href="/blog/" aria-label="Blog" class="footer-profile-link"><i class="ph-duotone ph-notepad"></i></a>
                )}
                <a href="/#projects" aria-label="Live project demos" class="footer-profile-link"><i class="ph-duotone ph-game-controller"></i></a>
            </div>
        </div>
        <div class="footer-right">
            <p class="copyright">© {year} Austin Orphan</p>
        </div>
    </div>
</footer>

<script>
  (function() {
    const backToTopBtn = document.querySelector('.footer-return');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

    // The parallax reveal belongs to the fixed variant alone. The static
    // footer sits in normal flow and needs no scroll handling at all.
    const footer = document.querySelector<HTMLElement>('.site-footer--fixed');
    const contactSection = document.querySelector<HTMLElement>('#contact');
    if (footer && contactSection) {
      footer.style.transition = 'transform 0.1s ease-out, opacity 0.1s ease-out';
      footer.style.willChange = 'transform, opacity';
      let ticking = false;

      function updateFooterParallax(bar: HTMLElement, contact: HTMLElement) {
        const scrollPosition = window.pageYOffset + window.innerHeight;
        const contactBottom = contact.offsetTop + contact.offsetHeight;
        if (scrollPosition > contactBottom) {
          const progress = Math.min(1, (scrollPosition - contactBottom) / 120);
          bar.style.transform = `translateY(${(1 - progress) * 30}px)`;
          bar.style.opacity = String(progress);
          bar.style.zIndex = '10000';
        } else {
          bar.style.transform = 'translateY(50px)';
          bar.style.opacity = '0';
          bar.style.zIndex = '-1';
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => updateFooterParallax(footer, contactSection));
          ticking = true;
        }
      }, { passive: true });
      updateFooterParallax(footer, contactSection);
    }
  })();
</script>
