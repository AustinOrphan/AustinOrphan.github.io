---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
    <div class="footer-top">
        <button class="footer-return" aria-label="Back to top">
            <i class="ph-duotone ph-arrow-up"></i>
            <span>Top</span>
        </button>
    </div>
    <div class="footer-decoration">
        <div class="decoration-line-full"></div>
    </div>
    <div class="footer-content">
        <!-- Mark left, copyright right. Two alternatives were rendered and kept
             in mind: copyright left with the mark right (the original grid,
             where the mark reads as a corner afterthought), and this same
             arrangement with the mark at 34px instead of 44px. -->
        <div class="footer-left">
            <Logo variant="hero" size={44} class="footer-logo" />
        </div>
        <div class="footer-center">
            <div class="footer-profiles">
                <a href="https://github.com/austinorphan" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="footer-profile-link"><i class="ph-duotone ph-github-logo"></i></a>
                <a href="https://www.linkedin.com/in/austinorphan/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="footer-profile-link"><i class="ph-duotone ph-linkedin-logo"></i></a>
                <a href="mailto:AustinGOrphan@gmail.com" aria-label="Email" class="footer-profile-link"><i class="ph-duotone ph-envelope-simple"></i></a>
            </div>
        </div>
        <div class="footer-right">
            <p class="copyright">© {year} Austin Orphan</p>
        </div>
    </div>
</footer>

<script>
  (function() {
    const backToTopBtn = document.querySelector<HTMLElement>('.footer-return');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

    const footer = document.querySelector<HTMLElement>('.site-footer');
    const contactSection = document.querySelector<HTMLElement>('#contact');
    if (footer && contactSection) {
      // Captured locally because the checker will not carry the narrowing from
      // the guard above into the hoisted function declaration below.
      const footerEl = footer;
      const contactEl = contactSection;
      footerEl.style.transition = 'transform 0.1s ease-out, opacity 0.1s ease-out';
      footerEl.style.willChange = 'transform, opacity';
      let ticking = false;

      function updateFooterParallax() {
        const scrollPosition = window.pageYOffset + window.innerHeight;
        const contactBottom = contactEl.offsetTop + contactEl.offsetHeight;
        if (scrollPosition > contactBottom) {
          const progress = Math.min(1, (scrollPosition - contactBottom) / 120);
          footerEl.style.transform = `translateY(${(1 - progress) * 30}px)`;
          // style.opacity is a string; a bare number worked only by coercion.
          footerEl.style.opacity = String(progress);
          footerEl.style.zIndex = '10000';
        } else {
          footerEl.style.transform = 'translateY(50px)';
          footerEl.style.opacity = '0';
          footerEl.style.zIndex = '-1';
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(updateFooterParallax); ticking = true; }
      }, { passive: true });
      updateFooterParallax();
    }
  })();
</script>
